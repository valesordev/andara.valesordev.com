# The kubeconfig `make scripts-test` runs under (AW-INF-053): the tests never read or write the
# developer's own. Its current-context is some-other, so a script that acts on the ambient context
# would name some-other, and one that moves it would change this file; test_kube.py checks both.
# Every server is 127.0.0.1:1, where nothing listens, so a call that escapes a stub fails at once.
apiVersion: v1
kind: Config
current-context: some-other
clusters:
- name: kind-andara
  cluster: {server: "https://127.0.0.1:1"}
- name: kind-ci
  cluster: {server: "https://127.0.0.1:1"}
- name: some-other
  cluster: {server: "https://127.0.0.1:1"}
users:
- name: kind-andara
  user: {token: t}
- name: kind-ci
  user: {token: t}
- name: some-other
  user: {token: t}
contexts:
- name: kind-andara
  context: {cluster: kind-andara, user: kind-andara}
- name: kind-ci
  context: {cluster: kind-ci, user: kind-ci}
- name: some-other
  context: {cluster: some-other, user: some-other}
