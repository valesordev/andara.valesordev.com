# The andara-server image: what `make up` runs locally, what `make image && make kind-load`
# puts in a kind cluster, and what CI publishes to ghcr.io/valesordev/andara-server on every
# merge to main (`make image-publish`, AW-INF-013) for dev and prod to pull. One file, so the
# binary a developer tested is the binary that ships.
#
# CLAUDE.md §2: the Dockerfile runs *around* the game, so it is architecture lane; everything
# it compiles is implementation lane.

FROM golang:1.25-alpine AS build
WORKDIR /src

RUN apk add --no-cache git ca-certificates

# Dependency layer first, so a source-only change does not re-download the module graph.
COPY go.mod go.sum* ./
RUN go mod download

COPY . .

# Version and commit are stamped in rather than read at runtime: andara_build_info must
# name the build that is actually running, and a binary that reads its own version from
# the environment can be lied to.
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 go build \
      -trimpath \
      -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
      -o /out/andara-server ./cmd/andara-server
# The state projector (AW-SRV-019) ships in the same image: it is a replica of the
# simulation, and a replica built from a different commit than the server it replicates is
# a divergence waiting for its first tick. The chart's projector Deployment runs it.
RUN CGO_ENABLED=0 go build \
      -trimpath \
      -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
      -o /out/andara-projector ./cmd/andara-projector

FROM alpine:3.21
# Build stages do not share ARGs; the labels need them again. `source` links the ghcr
# package to the repository; `revision` is what `make image-check` holds a sha- tag to.
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/valesordev/andara.valesordev.com" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0"
RUN apk add --no-cache ca-certificates wget \
 && adduser -D -u 10001 andara
COPY --from=build /out/andara-server /usr/local/bin/andara-server
COPY --from=build /out/andara-projector /usr/local/bin/andara-projector
USER andara
EXPOSE 8443 8080
ENTRYPOINT ["/usr/local/bin/andara-server"]
