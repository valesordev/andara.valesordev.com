{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "andara chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "snapshots",
    "probes",
    "terminationGracePeriodSeconds",
    "host",
    "ingress",
    "tls",
    "admin"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "description": "StatefulSet replicas. Each replica owns the Partitions p where p mod replicaCount == ordinal (ADR-0001)."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "kafka",
                "dir"
              ],
              "description": "ANDARA_CONTENT_SOURCE (AW-SRV-001). Default when unset: 'kafka'."
            },
            "path": {
              "type": "string",
              "description": "ANDARA_CONTENT_PATH (AW-SRV-001). Default when unset: './content'."
            },
            "strict_orphans": {
              "type": "boolean",
              "description": "ANDARA_STRICT_ORPHANS (AW-SRV-001). Default when unset: False."
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "ANDARA_HTTP_PORT (AW-INF-002). Default when unset: 8080."
            }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "service_name": {
              "type": "string",
              "description": "ANDARA_SERVICE_NAME (AW-SRV-001). Default when unset: 'andara-server'."
            },
            "environment": {
              "type": "string",
              "enum": [
                "local",
                "dev",
                "prod"
              ],
              "description": "ANDARA_ENV (AW-INF-002). Default when unset: 'local'."
            },
            "log_format": {
              "type": "string",
              "enum": [
                "json",
                "text"
              ],
              "description": "ANDARA_LOG_FORMAT (AW-SRV-001). Default when unset: 'json'."
            },
            "log_level": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ],
              "description": "ANDARA_LOG_LEVEL (AW-SRV-001). Default when unset: 'info'."
            },
            "otlp_endpoint": {
              "type": "string",
              "description": "ANDARA_OTLP_ENDPOINT (AW-SRV-001). Default when unset: 'localhost:4317'."
            }
          }
        },
        "sim": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "kafka",
                "memory"
              ],
              "description": "ANDARA_SIM_SOURCE (AW-SRV-002). Default when unset: 'kafka'."
            },
            "tick_rate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "ANDARA_TICK_RATE (AW-SRV-002). Default when unset: 10."
            },
            "tick_budget_ms": {
              "type": "integer",
              "minimum": 1,
              "description": "ANDARA_TICK_BUDGET_MS (AW-SRV-002). Default when unset: 50."
            },
            "max_per_tick": {
              "type": "integer",
              "minimum": 1,
              "description": "ANDARA_MAX_PER_TICK (AW-SRV-002). Default when unset: 1024."
            },
            "drain_timeout_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "ANDARA_DRAIN_TIMEOUT_MS (AW-SRV-002). Default when unset: 5000."
            },
            "seed": {
              "type": "integer",
              "description": "ANDARA_SIM_SEED (AW-SRV-002). Default when unset: 0."
            },
            "checkpoint_every_ticks": {
              "type": "integer",
              "minimum": 1,
              "description": "ANDARA_CHECKPOINT_EVERY_TICKS (AW-SRV-002). Default when unset: 100."
            }
          }
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_intent_bytes": {
              "type": "integer",
              "minimum": 1,
              "description": "ANDARA_MAX_INTENT_BYTES (AW-SRV-003). Default when unset: 4096."
            },
            "verb_table_path": {
              "type": "string",
              "description": "ANDARA_VERB_TABLE (AW-SRV-003). Default when unset: ''."
            }
          }
        },
        "grpc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "listen": {
              "type": "string",
              "description": "ANDARA_GRPC_LISTEN (AW-SRV-005). Default when unset: ':8443'."
            },
            "tls_cert_file": {
              "type": "string",
              "description": "ANDARA_TLS_CERT_FILE (AW-SRV-005). Default when unset: ''."
            },
            "tls_key_file": {
              "type": "string",
              "description": "ANDARA_TLS_KEY_FILE (AW-SRV-005). Default when unset: ''."
            },
            "drain_timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$",
              "description": "ANDARA_GRPC_DRAIN_TIMEOUT (AW-SRV-005). Default when unset: '15s'."
            },
            "max_recv_bytes": {
              "type": "integer",
              "minimum": 1,
              "description": "ANDARA_GRPC_MAX_RECV_BYTES (AW-SRV-005). Default when unset: 65536."
            },
            "max_request_timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$",
              "description": "ANDARA_GRPC_MAX_REQUEST_TIMEOUT (AW-SRV-005). Default when unset: '30s'."
            }
          }
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_version": {
              "type": "integer",
              "minimum": 1,
              "description": "ANDARA_PROTOCOL_MIN (AW-SRV-005). Default when unset: 1."
            },
            "max_version": {
              "type": "integer",
              "minimum": 1,
              "description": "ANDARA_PROTOCOL_MAX (AW-SRV-005). Default when unset: 1."
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subscriber_buffer": {
              "type": "integer",
              "minimum": 1,
              "description": "ANDARA_SUBSCRIBER_BUFFER (AW-SRV-004). Default when unset: 1024."
            },
            "max_subscribers": {
              "type": "integer",
              "minimum": 1,
              "description": "ANDARA_MAX_SUBSCRIBERS (AW-SRV-004). Default when unset: 10000."
            }
          }
        },
        "kafka": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brokers": {
              "type": "string",
              "description": "ANDARA_KAFKA_BROKERS (AW-SRV-008). Default when unset: ''."
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "store": {
              "type": "string",
              "enum": [
                "kafka",
                "memory"
              ],
              "description": "ANDARA_AUTH_STORE (AW-SRV-008). Default when unset: 'kafka'."
            },
            "session_ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$",
              "description": "ANDARA_AUTH_SESSION_TTL (AW-SRV-008). Default when unset: '1h'."
            },
            "refresh_ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$",
              "description": "ANDARA_AUTH_REFRESH_TTL (AW-SRV-008). Default when unset: '720h'."
            },
            "token_key_file": {
              "type": "string",
              "description": "ANDARA_AUTH_TOKEN_KEY_FILE (AW-SRV-008). Default when unset: ''."
            },
            "argon2": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "memory_kib": {
                  "type": "integer",
                  "minimum": 8192,
                  "description": "ANDARA_AUTH_ARGON2_MEMORY_KIB (AW-SRV-008). Default when unset: 65536."
                },
                "time": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "ANDARA_AUTH_ARGON2_TIME (AW-SRV-008). Default when unset: 3."
                },
                "threads": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "ANDARA_AUTH_ARGON2_THREADS (AW-SRV-008). Default when unset: 4."
                }
              }
            },
            "rate_limit": {
              "type": "string",
              "description": "ANDARA_AUTH_RATE_LIMIT (AW-SRV-008). Default when unset: '10/m'."
            },
            "invite_ttl": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$",
              "description": "ANDARA_AUTH_INVITE_TTL (AW-SRV-008). Default when unset: '168h'."
            },
            "recheck_interval": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$",
              "description": "ANDARA_AUTH_RECHECK_INTERVAL (AW-SRV-008). Default when unset: '30s'."
            },
            "k8s_issuer": {
              "type": "string",
              "description": "ANDARA_AUTH_K8S_ISSUER (AW-SRV-008). Default when unset: ''."
            },
            "k8s_jwks_url": {
              "type": "string",
              "description": "ANDARA_AUTH_K8S_JWKS_URL (AW-SRV-008). Default when unset: ''."
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkdead_max": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$",
              "description": "ANDARA_LINKDEAD_MAX (AW-SRV-008). Default when unset: '300s'."
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Secret references only. A value here is a Secret name, never secret material (AC-4).",
      "properties": {
        "tokenKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tlsCert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "certKey": {
              "type": "string",
              "minLength": 1
            },
            "keyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "kafkaCreds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            }
          }
        },
        "bootstrapOperator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit overrides. When empty, requests derive from measurements.yaml \u00d7 resourcesMultiplier.",
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "resourcesMultiplier": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "description": "Headroom over the p99 in measurements.yaml when resources.requests is not set."
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600,
      "description": "Must cover the pre-stop snapshot (AW-INF-007 derives it)."
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup",
        "readiness",
        "liveness"
      ],
      "properties": {
        "startup": {
          "$ref": "#/$defs/probe"
        },
        "readiness": {
          "$ref": "#/$defs/probe"
        },
        "liveness": {
          "$ref": "#/$defs/probe"
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "description": "Edge routing through the cluster's Traefik (AW-INF-006): two Ingresses on `host`, HTTPS/HTTP-2 to the pod.",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "description": "Traefik entrypoint the routers bind to; websecure is the cluster's :443."
        }
      }
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
      "description": "The one hostname both Ingresses serve and the edge certificate's SAN."
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "enum": [
            "andara-ca",
            "letsencrypt",
            "letsencrypt-staging"
          ],
          "description": "ClusterIssuer for the edge certificate. andara-ca is bootstrapped by `make helm-install`; the ACME issuers are the cluster's own."
        },
        "privateIssuer": {
          "type": "string",
          "enum": [
            "andara-ca"
          ],
          "description": "ClusterIssuer for the server certificate the pod presents on the second leg. Always the private CA."
        },
        "duration": {
          "type": "string",
          "pattern": "^[0-9]+h$"
        },
        "renewBefore": {
          "type": "string",
          "pattern": "^[0-9]+h$"
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedCIDRs"
      ],
      "properties": {
        "allowedCIDRs": {
          "type": "array",
          "minItems": 1,
          "description": "Source ranges the Admin Ingress admits (Traefik ipAllowList); every other source is 403 at the edge.",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Default-deny ingress to the server pod; the grpc port admits ingressNamespace and agentNamespace only (AW-INF-006 AC-6).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "observabilityNamespace": {
          "type": "string"
        },
        "ingressNamespace": {
          "type": "string"
        },
        "agentNamespace": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "projectors": {
      "type": "object",
      "additionalProperties": false,
      "description": "One Deployment each (AW-SRV-017/018/019). Disabled until their binaries exist.",
      "properties": {
        "state": {
          "$ref": "#/$defs/projector"
        },
        "redis": {
          "$ref": "#/$defs/projector"
        },
        "postgres": {
          "$ref": "#/$defs/projector"
        }
      }
    },
    "contentVolume": {
      "type": "object",
      "additionalProperties": false,
      "description": "When configMapName is set, that ConfigMap is mounted read-only at /content for server.content.source=dir (local and CI). Production content comes from the store (ADR-0004).",
      "properties": {
        "configMapName": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodSeconds",
        "failureThreshold"
      ],
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "projector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
