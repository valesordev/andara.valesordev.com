{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/bin/role\" hook-session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/bin/role\" hook-pre-tool-use"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/bin/role\" hook-pre-bash"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make check-targets)",
      "Bash(make help)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make vet)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make test-determinism)",
      "Bash(make test-integration)",
      "Bash(make scripts-test)",
      "Bash(make build)",
      "Bash(make build-info)",
      "Bash(make goldens)",
      "Bash(make proto)",
      "Bash(make proto-check)",
      "Bash(make core-versions-check)",
      "Bash(make content-grammar-check)",
      "Bash(make content-conformance)",
      "Bash(make k8s-dry)",
      "Bash(make values-schema)",
      "Bash(make values-schema-check)",
      "Bash(make helm-test)",
      "Bash(make license-check)",
      "Bash(make image-check)",
      "Bash(make cli-offline-check)",
      "Bash(make cli-release-check)",
      "Bash(make schemas-check)",
      "Bash(make schemas-diff)",
      "Bash(make topics-diff)",
      "Bash(make observe-check)",
      "Bash(make argocd-status)",
      "Bash(make ps)",
      "Bash(make logs)",
      "Bash(make up)",
      "Bash(make image)",
      "Bash(make kind-load)",
      "Bash(make helm-install ENV=dev)",
      "Bash(make stack-smoke)",
      "Bash(make stack-play)",
      "Bash(go test ./...)",
      "Bash(go test -race ./...)",
      "Bash(go vet ./...)",
      "Bash(go build ./...)",
      "Bash(gofmt -l .)",
      "Bash(kind get clusters)",
      "Bash(kubectl config current-context)",
      "Bash(kubectl get pods -A)",
      "Bash(kubectl get nodes)",
      "Bash(kubectl get namespaces)",
      "Bash(kubectl get applications -A)",
      "Bash(helm list -A)",
      "Bash(docker ps)",
      "Bash(docker compose ps)",
      "Bash(.claude/bin/role show:*)",
      "Bash(.claude/bin/role list)",
      "Bash(.claude/bin/role owners:*)",
      "Bash(.claude/bin/role check-cmd)",
      "Bash(.claude/bin/sprint-state:*)",
      "Bash(.claude/bin/story show:*)",
      "Bash(.claude/bin/story list:*)"
    ],
    "ask": [
      "Bash(make down)",
      "Bash(make env-destroy:*)",
      "Bash(make world-reset:*)",
      "Bash(make content-seed:*)",
      "Bash(make projector-stop:*)",
      "Bash(make projector-start:*)",
      "Bash(make projector-rebuild:*)",
      "Bash(make kafka-broker-bounce:*)",
      "Bash(make topics-apply:*)",
      "Bash(make schemas-apply:*)",
      "Bash(make argocd-install:*)",
      "Bash(make argocd-recover:*)",
      "Bash(make argocd-uninstall:*)",
      "Bash(make image-publish:*)",
      "Bash(make cli-release)",
      "Bash(make cli-release-publish:*)",
      "Bash(make clean)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(helm uninstall:*)",
      "Bash(kubectl get secret:*)",
      "Bash(kubectl get secrets:*)"
    ]
  }
}
