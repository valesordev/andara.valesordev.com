#!/usr/bin/env python3
"""Report sprint state from docs/sprints/ on a git ref (default origin/main).

Source of truth: automate.bashburn.com / plugins/valesor-dev/bin/sprint-state.
Vendored into target repos as .claude/bin/sprint-state. Don't edit it there.

    sprint-state [--ref origin/main] [--dir docs/sprints]

Reads only plan files named SPRINT-<N>.md (not SPRINT-<N>-demo.md) and the
first `Status:` line of each. Prints one line per sprint, then:

    state:   first | active | closed | planned
    current: SPRINT-NN        (the sprint that state refers to; absent for first)
    next:    SPRINT-MM        (the sprint the next planning session writes or activates)

States:
    first    no sprint files: plan SPRINT-01
    active   exactly one active sprint: close it, then plan `next`
    closed   none active, highest is closed: plan `next`
    planned  none active, highest is planned: review and activate it (`next` = it)

Exit 0 on a valid state; exit 1 with `state: invalid` and the reasons when the
files contradict each other (an unknown status, or any sprint other than the
highest-numbered one not closed); exit 2 when the ref can't be read.
"""
from __future__ import annotations

import argparse
import re
import subprocess
import sys

PLAN = re.compile(r"(?:^|/)SPRINT-(\d+)\.md$")
STATUS = re.compile(r"^Status:\s*([A-Za-z-]+)", re.M)
VALID = {"planned", "active", "closed"}


def git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def name(n: int) -> str:
    return f"SPRINT-{n:02d}"


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--ref", default="origin/main")
    ap.add_argument("--dir", default="docs/sprints")
    a = ap.parse_args(argv)

    try:
        git("rev-parse", "--verify", "--quiet", a.ref)
    except subprocess.CalledProcessError:
        print(f"sprint-state: can't read {a.ref}. Run `git fetch origin` first.", file=sys.stderr)
        return 2
    try:
        listing = git("ls-tree", "--name-only", f"{a.ref}:{a.dir}").split()
    except subprocess.CalledProcessError:
        listing = []  # directory doesn't exist yet

    sprints: list[tuple[int, str]] = []
    for f in listing:
        m = PLAN.search(f)
        if not m:
            continue
        text = git("show", f"{a.ref}:{a.dir}/{f}")
        s = STATUS.search(text)
        sprints.append((int(m.group(1)), s.group(1).lower() if s else "missing"))
    sprints.sort()

    for n, st in sprints:
        print(f"{name(n):12} {st}")

    problems: list[str] = []
    nums = [n for n, _ in sprints]
    if len(set(nums)) != len(nums):
        problems.append("duplicate sprint numbers")
    for n, st in sprints:
        if st not in VALID:
            problems.append(f"{name(n)} has status '{st}' (expected planned | active | closed)")
    earlier_open = [n for n, st in sprints[:-1] if st != "closed"]
    if earlier_open:
        problems.append("only the highest-numbered sprint may be open; also open: "
                        + ", ".join(map(name, earlier_open)))

    if problems:
        print("state:   invalid")
        for p in problems:
            print(f"problem: {p}")
        return 1

    if not sprints:
        print("state:   first")
        print(f"next:    {name(1)}")
    else:
        top, st = sprints[-1]
        if st == "active":
            print("state:   active")
            print(f"current: {name(top)}")
            print(f"next:    {name(top + 1)}")
        elif st == "closed":
            print("state:   closed")
            print(f"current: {name(top)}")
            print(f"next:    {name(top + 1)}")
        else:  # planned
            print("state:   planned")
            print(f"current: {name(top)}")
            print(f"next:    {name(top)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
