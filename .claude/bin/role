#!/usr/bin/env python3
"""Per-session role control for Claude Code.

Source of truth: automate.valesordev.com / plugins/valesor-dev/bin/role.
Vendored into target repos as .claude/bin/role by `make install`. Don't edit it there.

Role definitions live in <repo>/.claude/roles/<role>.md: YAML-ish frontmatter
(role, aliases, branch_prefix, writes, skills, summary) followed by the role charter.
`writes` entries are `dir/` prefixes, exact paths, or globs; `!entry` excludes.
<repo>/.claude/roles/_repo.md holds repo-wide keys (generated).

Session state is kept in <git-common-dir>/claude-roles/<session_id>, so it is
per session, shared across worktrees, and never committed.

Commands:
  role list
  role help                    the role catalog as a markdown table (role, aliases, assist level, summary, skills)
  role set <role|none> <session_id>
  role show <session_id>
  role require <role> <session_id>
  role clear <session_id>
  role check-cmd               print the repo's check command (_repo.md `check:`)
  role owners <path>…          print each path's owner: role names, `generated`, or `unowned`
  role reviewed                record HEAD as reviewed by /pre-pr
  role reviewed --show         report whether HEAD has been reviewed
  role hook-session-start      (stdin: SessionStart hook JSON)
  role hook-pre-tool-use       (stdin: PreToolUse hook JSON; file tools)
  role hook-pre-bash           (stdin: PreToolUse hook JSON; Bash)

Every PR a role opens carries the label `role:<role>`; hook-pre-bash denies a
`gh pr create` without it.

hook-pre-bash also denies, in every mode, `git add -A`/`.`, `git commit -a`,
`pkill -f`, and restore/checkout/reset --hard/switch -f over uncommitted changes.

Story guard: in a repo with `project:` in _repo.md, hook-pre-bash denies raw
`gh issue edit/close/reopen/delete/transfer` on story issues, non-read `gh project`
commands, and `gh api` writes to Projects, story issues, sub-issues, or
dependencies, and GraphQL mutations. Stories change through bin/story, which
applies the role's `transitions:` and `story_edits:`. It asks under /role none.

Review gate: in a role session, hook-pre-bash denies `git push` unless every
commit it sends was recorded by `role reviewed` (the last step of /pre-pr) or is
already on origin/main, and denies `gh pr create` unless HEAD was. `--all`,
`--mirror`, and `--tags` are denied; deletes are allowed. Under /role none it
asks instead. Markers live in <git-common-dir>/claude-roles/.reviewed/<sha>.
"""
from __future__ import annotations

import fnmatch
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path, PurePosixPath

UNRESTRICTED = "none"
PUNCT = ";&|()\n<>"
# Words that can precede a command in the same simple command or compound.
PREFIX_WORDS = {"then", "do", "else", "elif", "if", "while", "until", "{", "!", "time",
                "exec", "nohup", "builtin"}
# Commands that run another command given later in their arguments.
WRAPPERS = {"sudo", "doas", "xargs", "timeout", "nice", "ionice", "stdbuf", "command",
            "env", "chronic", "unbuffer", "flock", "setsid", "caffeinate"}
SHELLS = {"sh", "bash", "zsh", "dash", "ksh"}
SHELL_C_RE = re.compile(r"^-[A-Za-z]*c[A-Za-z]*$")
GIT_OPTS_WITH_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace",
                       "--exec-path", "--super-prefix", "--config-env"}
# Builtins can't be shadowed by aliases, so these never need an alias lookup.
GIT_BUILTINS = set("""add am apply archive bisect blame branch bundle cat-file check-ignore
    checkout cherry cherry-pick clean clone commit config count-objects describe diff
    diff-tree fetch for-each-ref format-patch fsck gc grep hash-object help init log
    ls-files ls-remote ls-tree merge merge-base mv notes pull push range-diff rebase
    reflog remote repack replace reset restore rev-list rev-parse revert rm shortlog
    show show-ref sparse-checkout stash status submodule switch symbolic-ref tag
    update-index update-ref var verify-commit version worktree""".split())
PUSH_OPTS_WITH_VALUE = {"-o", "--push-option", "--repo", "--receive-pack", "--exec"}
GH_OPTS_WITH_VALUE = {"-R", "--repo"}
# Git and shell guards: denied in every mode, because they lose work or hit other sessions.
GUARDED_GIT = {"add", "commit", "restore", "checkout", "reset", "switch"}
ADD_OPTS_WITH_VALUE = {"--chmod", "--pathspec-from-file"}
ADD_EVERYTHING = {".", "./", ":/", ":", "*"}
COMMIT_OPTS_WITH_VALUE = {"-m", "--message", "-F", "--file", "-C", "--reuse-message", "-c",
                          "--reedit-message", "-t", "--template", "--author", "--date", "--fixup",
                          "--squash", "--cleanup", "--trailer"}
RESTORE_OPTS_WITH_VALUE = {"-s", "--source", "--pathspec-from-file", "--conflict"}
CHECKOUT_OPTS_WITH_VALUE = {"-b", "-B", "--orphan", "--conflict", "--pathspec-from-file"}
SWITCH_OPTS_WITH_VALUE = {"-c", "--create", "-C", "--force-create", "--orphan", "--conflict"}
# Long options the guards read, per command. Git and pkill accept any unique prefix
# (`--har` is `--hard`), so arguments are expanded against these before matching.
GUARD_LONGS = {
    "git add": ["--all", "--no-ignore-removal", "--chmod", "--pathspec-from-file"],
    "git commit": ["--all", "--amend", "--author", "--message", "--file", "--reuse-message",
                   "--reedit-message", "--template", "--date", "--fixup", "--squash", "--cleanup",
                   "--trailer"],
    "git restore": ["--staged", "--worktree", "--source", "--pathspec-from-file", "--conflict"],
    "git checkout": ["--force", "--orphan", "--conflict", "--pathspec-from-file"],
    "git reset": ["--hard", "--soft", "--mixed", "--merge", "--keep"],
    "git switch": ["--discard-changes", "--force", "--create", "--force-create", "--orphan",
                   "--conflict"],
    "pkill": ["--full", "--pgroup", "--group", "--parent", "--session", "--terminal", "--euid",
              "--uid", "--pidfile", "--signal", "--ns", "--nslist"],
}
PKILL_OPTS_WITH_VALUE = {"-g", "--pgroup", "-G", "--group", "-P", "--parent", "-s", "--session",
                         "-t", "--terminal", "-u", "--euid", "-U", "--uid", "-F", "--pidfile",
                         "--signal", "--ns", "--nslist"}
GH_PR_CREATE_OPTS_WITH_VALUE = {"-R", "--repo", "-H", "--head", "-B", "--base", "-t", "--title",
                                "-b", "--body", "-F", "--body-file", "-l", "--label", "-a",
                                "--assignee", "-r", "--reviewer", "-m", "--milestone", "-p",
                                "--project", "-T", "--template", "--recover"}
GH_ISSUE_WRITES = {"edit", "close", "reopen", "delete", "transfer"}
GH_PROJECT_READS = {"list", "view", "item-list", "field-list"}
GH_ISSUE_OPTS_WITH_VALUE = {"-R", "--repo", "-t", "--title", "-b", "--body", "-F", "--body-file",
                            "-c", "--comment", "-r", "--reason", "-m", "--milestone", "-a",
                            "--assignee", "-l", "--label", "-p", "--project", "--add-assignee",
                            "--remove-assignee", "--add-label", "--remove-label", "--add-project",
                            "--remove-project", "-T", "--template", "--type", "--duplicate-of",
                            "-B", "--base", "-n", "--name"}
GH_API_OPTS_WITH_VALUE = {"-X", "--method", "-f", "--raw-field", "-F", "--field", "-H", "--header",
                          "--input", "-q", "--jq", "-t", "--template", "--hostname", "--cache",
                          "-p", "--preview"}
ISSUE_API_RE = re.compile(r"(?:^|/)issues/(\d+)(?:/(?:sub_issues?|sub_issues/priority|"
                          r"dependencies/\S*))?/?$")
HEREDOC_RE = re.compile(
    r"(?<![<])<<(?!<)-?[ \t]*(['\"]?)([A-Za-z_]\w*)\1[^\n]*\n.*?(?:\n[ \t]*\2[ \t]*(?=\n|$)|$)", re.S)
VAR_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$", re.S)
SESSION_RE = re.compile(r"^[A-Za-z0-9_.-]{1,128}$")
REVIEWED = ".reviewed"
DEFAULT_CHECK = "make check"


# --------------------------------------------------------------------------- repo

def _git(cwd: Path, *args: str) -> str:
    return subprocess.run(
        ["git", "-C", str(cwd), *args], capture_output=True, text=True, check=True
    ).stdout.strip()


def _existing_dir(p: Path) -> Path:
    p = p if p.is_dir() else p.parent
    while not p.exists():
        p = p.parent
    return p


def repo_root(start: Path) -> Path | None:
    try:
        return Path(_git(_existing_dir(start), "rev-parse", "--show-toplevel"))
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def state_dir(root: Path) -> Path:
    common = Path(_git(root, "rev-parse", "--git-common-dir"))
    if not common.is_absolute():
        common = (root / common).resolve()
    return common / "claude-roles"


# ---------------------------------------------------------------------- roles

def parse_frontmatter(text: str) -> tuple[dict, str]:
    """Minimal parser: `key: value` and `key: [a, b]` lines only."""
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end < 0:
        return {}, text
    meta: dict = {}
    for line in text[4:end].splitlines():
        line = line.split(" #", 1)[0].rstrip()
        if not line.strip() or ":" not in line:
            continue
        key, val = (s.strip() for s in line.split(":", 1))
        if val.startswith("[") and val.endswith("]"):
            meta[key] = [v.strip().strip("'\"") for v in val[1:-1].split(",") if v.strip()]
        else:
            meta[key] = val.strip("'\"")
    body = text[end + 4 :].lstrip("\n")
    return meta, body


def lane_roles_dir() -> Path | None:
    """In a coordinator lane, the role files the coordinator copied next to this hook when it
    started the run: the lane's checkout is the lane's to edit, so policy never comes from it."""
    if not os.environ.get("COORDINATOR_LANE"):
        return None
    d = Path(__file__).resolve().parent / "roles"
    return d if d.is_dir() else None


class Roles:
    def __init__(self, root: Path):
        self.root = root
        self.dir = lane_roles_dir() or root / ".claude" / "roles"
        self.roles: dict[str, tuple[dict, str]] = {}
        self.alias: dict[str, str] = {}
        self.repo: dict = {}
        if not self.dir.is_dir():
            return
        for f in sorted(self.dir.glob("*.md")):
            meta, body = parse_frontmatter(f.read_text())
            if f.name.startswith("_"):
                if f.name == "_repo.md":
                    self.repo = meta
                continue
            name = meta.get("role", f.stem)
            self.roles[name] = (meta, body)
            self.alias[name] = name
            for a in meta.get("aliases", []):
                self.alias[a] = name

    def resolve(self, name: str) -> str | None:
        if name == UNRESTRICTED:
            return UNRESTRICTED
        return self.alias.get(name)

    def owners(self, rel: str) -> list[str]:
        return [n for n, (m, _) in self.roles.items() if matches(rel, m.get("writes", []))]

    def names(self) -> str:
        return " | ".join([*self.roles, UNRESTRICTED])


def _match_one(rel: str, p: str) -> bool:
    if p.endswith("/"):
        return rel.startswith(p)
    return rel == p or fnmatch.fnmatchcase(rel, p)


def matches(rel: str, patterns: list[str]) -> bool:
    """Prefix (`dir/`), exact, or glob patterns; `!pattern` excludes and wins."""
    if any(_match_one(rel, p[1:]) for p in patterns if p.startswith("!")):
        return False
    return any(_match_one(rel, p) for p in patterns if not p.startswith("!"))


# ---------------------------------------------------------------------- state

def _check_session(sid: str) -> str:
    if not SESSION_RE.match(sid or ""):
        sys.exit(f"role: invalid session id {sid!r}")
    return sid


def hook_role(root: Path, sid: str) -> str | None:
    """A hook's view of the session role: an invalid session id has none (fails closed)."""
    return get_role(root, sid) if SESSION_RE.match(sid or "") else None


def get_role(root: Path, sid: str) -> str | None:
    f = state_dir(root) / _check_session(sid)
    return f.read_text().strip() if f.is_file() else None


def pin_file(root: Path, sid: str) -> Path:
    return state_dir(root) / ".pinned" / _check_session(sid)


def put_role(root: Path, sid: str, role: str | None, pinned: bool = False) -> None:
    """Record a session's role. `pinned` (the coordinator, for a lane) fixes it: the `role set` and
    `role clear` commands refuse a pinned session, so a lane can't re-role itself. Only this
    function, called by the coordinator, writes or releases a pin."""
    d = state_dir(root)
    f = d / _check_session(sid)
    if role is None:
        f.unlink(missing_ok=True)
        pin_file(root, sid).unlink(missing_ok=True)
        return
    d.mkdir(parents=True, exist_ok=True)
    f.write_text(role + "\n")
    if pinned:
        pin_file(root, sid).parent.mkdir(parents=True, exist_ok=True)
        pin_file(root, sid).write_text("coordinator\n")


# ------------------------------------------------------------- session worktrees
#
# `/role <role>` moves a person's session into its own worktree (Claude Code's EnterWorktree, under
# .claude/worktrees/), so the owner keeps working in the checkout they launched from. Not for `/role none`,
# a cloud session (its own container already), or a coordinator lane (the coordinator made its worktree).
WORKTREES = ".claude/worktrees"
ROLE_WORKTREE_PREFIX = "role-"   # the coordinator's clean and handoff leave these alone


def _common(root: Path) -> Path:
    return state_dir(root).parent


def main_root(root: Path) -> Path:
    return _common(root).parent


def in_linked_worktree(root: Path) -> bool:
    try:
        return Path(_git(root, "rev-parse", "--absolute-git-dir")).resolve() != _common(root).resolve()
    except subprocess.CalledProcessError:
        return False


def _worktree_note(root: Path, sid: str) -> Path:
    return state_dir(root) / ".worktree" / _check_session(sid)


def session_worktree(root: Path, sid: str) -> Path | None:
    """The worktree /role gave this session, if it still exists."""
    f = _worktree_note(root, sid)
    name = f.read_text().strip() if f.is_file() else ""
    wt = main_root(root) / WORKTREES / name if name else None
    return wt if wt and wt.is_dir() else None


def exclude_worktrees(root: Path) -> None:
    """Keep .claude/worktrees/ out of the main checkout's `git status` (and out of `git add .claude/`)."""
    f = _common(root) / "info" / "exclude"
    have = f.read_text().splitlines() if f.is_file() else []
    if WORKTREES + "/" not in have:
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text("\n".join(have + [WORKTREES + "/"]) + "\n")


def worktree_line(root: Path, role: str, sid: str) -> str | None:
    """What `role set` tells the session about its worktree, or None when it keeps its directory."""
    if role == UNRESTRICTED or os.environ.get("COORDINATOR_LANE") \
            or os.environ.get("CLAUDE_CODE_REMOTE", "").lower() in ("1", "true", "yes"):
        return None
    note = _worktree_note(root, sid)
    note.parent.mkdir(parents=True, exist_ok=True)
    if in_linked_worktree(root):
        if root.resolve().parent == (main_root(root) / WORKTREES).resolve():
            note.write_text(root.name + "\n")
        return f"Worktree: this session already works in {root}"
    name = ROLE_WORKTREE_PREFIX + role + "-" + re.sub(r"[^A-Za-z0-9._-]", "", sid)[:8]
    note.write_text(name + "\n")
    exclude_worktrees(root)
    return (f"Worktree: {name} (enter it with EnterWorktree, name {name}, before any other step: "
            f"the owner keeps the checkout this session started in)")


def head_sha(root: Path) -> str | None:
    try:
        return _git(root, "rev-parse", "HEAD")
    except subprocess.CalledProcessError:
        return None  # no commits yet


def is_reviewed(root: Path, sha: str | None) -> bool:
    return bool(sha) and (state_dir(root) / REVIEWED / sha).is_file()


def check_command(roles: Roles) -> str:
    return roles.repo.get("check", DEFAULT_CHECK)


def pr_label(role: str) -> str:
    return f"role:{role}"


def charter(roles: Roles, role: str) -> str:
    if role == UNRESTRICTED:
        return (
            "Role: none (unrestricted). No role charter applies; path ownership is "
            "not enforced. The repo CLAUDE.md still binds."
        )
    meta, body = roles.roles[role]
    skills = " ".join(f"/{s}" for s in meta.get("skills", [])) or "(none)"
    if not meta.get("writes"):  # a role that works outside the repo (e.g. in Notion)
        return "\n".join(
            [
                f"Active role: {role}",
                "Writable paths: (none). This role works outside the repo: it doesn't "
                "commit, push, or open PRs.",
                f"Role skills: {skills}",
                *([f"Story moves (.claude/bin/story): {', '.join(meta['transitions'])}"]
                  if meta.get("transitions") else []),
                "Repo edits are blocked or require the owner's approval.",
                "",
                body.rstrip(),
            ]
        )
    return "\n".join(
        [
            f"Active role: {role}",
            f"Branch prefix: {meta.get('branch_prefix', '(unset)')}",
            f"PR label: {pr_label(role)} (every PR you open: gh pr create --label {pr_label(role)})",
            f"Writable paths: {', '.join(meta.get('writes', [])) or '(none)'}",
            f"Role skills: {skills}",
            *([f"Story moves (.claude/bin/story): {', '.join(meta['transitions'])}"]
              if meta.get("transitions") else []),
            *([f"On merge (story-merge Action, from the PR's Story: lines): {', '.join(meta['on_merge'])}"]
              if meta.get("on_merge") else []),
            f"Review gate: run /pre-pr before any git push or gh pr create "
            f"(check command: {check_command(roles)}).",
            "Edits outside the writable paths are blocked or require the owner's approval.",
            "",
            body.rstrip(),
        ]
    )


# ------------------------------------------------------------------- commands

def _root_or_die() -> Path:
    root = repo_root(Path.cwd())
    if root is None:
        sys.exit("role: not inside a git repository")
    return root


def cmd_list(_: list[str]) -> int:
    roles = Roles(_root_or_die())
    for name, (meta, _) in roles.roles.items():
        al = ", ".join(meta.get("aliases", []))
        print(f"{name:16} {meta.get('branch_prefix', ''):8} {('aliases: ' + al) if al else ''}".rstrip())
    print(f"{UNRESTRICTED:16} unrestricted session, no ownership enforcement")
    return 0


ASSIST_LEVEL = re.compile(r"^Assist level: (L[0-3])\b", re.M)
ASSIST_NAMES = {"L0": "Coach", "L1": "Guide", "L2": "Pair", "L3": "Delegate"}


def assist_level(body: str) -> str | None:
    """The level a charter declares before its first `## ` section (`Assist level: L<n> — why`).
    An installed charter is already composed, so an `extends` base's line comes first."""
    m = ASSIST_LEVEL.search(re.split(r"^## ", body, maxsplit=1, flags=re.M)[0])
    return f"{m.group(1)} {ASSIST_NAMES[m.group(1)]}" if m else None


def cmd_help(_: list[str]) -> int:
    """What each role here is for, without setting one: aliases, assist level, `summary:`, skills."""
    roles = Roles(_root_or_die())
    cell = lambda v: (str(v).replace("|", "\\|").strip() or "—") if v else "—"  # noqa: E731
    print("| Role | Aliases | Assist level | Summary | Skills |")
    print("|---|---|---|---|---|")
    for name, (meta, body) in roles.roles.items():
        print(f"| `{name}` | {cell(', '.join(meta.get('aliases', [])))} | {cell(assist_level(body))} | "
              f"{cell(meta.get('summary'))} | {cell(', '.join(meta.get('skills', [])))} |")
    print(f"| `{UNRESTRICTED}` | — | — | Unrestricted session: no path ownership, and gated git and gh "
          f"commands ask instead of being denied | — |")
    return 0


def cmd_set(args: list[str]) -> int:
    if len(args) != 2 or not args[0].strip():
        root = _root_or_die()
        print(f"usage: role set <{Roles(root).names()}> <session_id>", file=sys.stderr)
        return 2
    root = _root_or_die()
    roles = Roles(root)
    role = roles.resolve(args[0].strip().lower())
    if role is None:
        print(f"role: unknown role {args[0]!r}. Choose one of: {roles.names()}", file=sys.stderr)
        return 1
    if pin_file(root, args[1]).exists():
        print("role: this session's role is fixed (a coordinator lane); it can't be changed", file=sys.stderr)
        return 1
    prev = get_role(root, args[1])
    put_role(root, args[1], role)
    wt = worktree_line(root, role, args[1])
    if wt:
        print(wt + "\n")
    if prev and prev != role:
        print(f"(role changed: {prev} -> {role})\n")
    print(charter(roles, role))
    return 0


def cmd_show(args: list[str]) -> int:
    if len(args) != 1:
        print("usage: role show <session_id>", file=sys.stderr)
        return 2
    print(get_role(_root_or_die(), args[0]) or "unset")
    return 0


def cmd_require(args: list[str]) -> int:
    if len(args) != 2:
        print("usage: role require <role> <session_id>", file=sys.stderr)
        return 2
    root = _root_or_die()
    want = Roles(root).resolve(args[0]) or args[0]
    have = get_role(root, args[1])
    if have != want:
        print(f"role: this skill needs role '{want}', session role is '{have or 'unset'}'. "
              f"Run /role {want} first.", file=sys.stderr)
        return 1
    return 0


def cmd_clear(args: list[str]) -> int:
    if len(args) != 1:
        print("usage: role clear <session_id>", file=sys.stderr)
        return 2
    root = _root_or_die()
    if pin_file(root, args[0]).exists():
        print("role: this session's role is fixed (a coordinator lane); it can't be cleared", file=sys.stderr)
        return 1
    put_role(root, args[0], None)
    print("role cleared")
    return 0


def cmd_check_cmd(_: list[str]) -> int:
    print(check_command(Roles(_root_or_die())))
    return 0


def cmd_owners(args: list[str]) -> int:
    if not args:
        print("usage: role owners <path>…", file=sys.stderr)
        return 2
    root = _root_or_die()
    roles = Roles(root)
    for a in args:
        path = Path(os.path.normpath(Path(a) if os.path.isabs(a) else Path.cwd() / a))
        try:
            rel = path.relative_to(root).as_posix()
        except ValueError:
            print(f"role: {a} is outside the repository", file=sys.stderr)
            return 1
        if matches(rel, roles.repo.get("generated", [])):
            owner = "generated"
        else:
            owner = ",".join(roles.owners(rel)) or "unowned"
        print(f"{rel}\t{owner}")
    return 0


def cmd_reviewed(args: list[str]) -> int:
    root = _root_or_die()
    sha = head_sha(root)
    if sha is None:
        print("role: no commits yet; nothing to review", file=sys.stderr)
        return 1
    if args == ["--show"]:
        ok = is_reviewed(root, sha)
        print(f"{sha[:12]} {'reviewed' if ok else 'not reviewed'}")
        return 0 if ok else 1
    if args:
        print("usage: role reviewed [--show]", file=sys.stderr)
        return 2
    if _git(root, "status", "--porcelain", "--untracked-files=no"):
        print("role: uncommitted changes to tracked files; commit them and review again",
              file=sys.stderr)
        return 1
    d = state_dir(root) / REVIEWED
    d.mkdir(parents=True, exist_ok=True)
    (d / sha).write_text(sha + "\n")
    print(f"{sha[:12]} recorded as reviewed")
    return 0


# ---------------------------------------------------------------------- hooks

def _hook_input() -> dict:
    try:
        return json.load(sys.stdin)
    except json.JSONDecodeError:
        return {}


def hook_session_start(_: list[str]) -> int:
    data = _hook_input()
    env_file, sid = os.environ.get("CLAUDE_ENV_FILE"), data.get("session_id", "")
    if env_file and SESSION_RE.match(sid):
        # bin/story reads the session's role through this; skills pass ${CLAUDE_SESSION_ID}.
        try:
            with open(env_file, "a") as f:
                f.write(f"export CLAUDE_SESSION_ID={sid}\n")
        except OSError:
            pass  # never block the charter on the env file
    root = repo_root(Path(data.get("cwd") or os.getcwd()))
    if root is None:
        return 0
    roles = Roles(root)
    if not roles.roles:
        return 0
    role = get_role(root, sid) if SESSION_RE.match(sid) else None
    if role:
        # resume / compact / clear with a role already set: re-inject the charter.
        wt = session_worktree(root, sid)
        cwd = Path(data.get("cwd") or os.getcwd()).resolve()
        if wt and not cwd.is_relative_to(wt.resolve()):
            print(f"This session works in its own worktree: run EnterWorktree with path {wt} before "
                  f"anything else, so the owner's checkout stays theirs.\n")
        print(charter(roles, role))
    else:
        print(
            "No role is set for this session. Before doing any work, ask the owner which role "
            f"this session is ({roles.names()}) and have them run /role <name>. "
            "Don't choose a role yourself. Edits inside the repo are blocked until a role is set."
        )
    return 0


def _decision(kind: str, reason: str) -> int:
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": kind,
        "permissionDecisionReason": reason,
    }}))
    return 0


LANE_READ_TOOLS = {"Read", "NotebookRead", "Glob", "Grep", "LS"}


def lane_scratch() -> Path | None:
    """The lane's scratch directory, outside its worktree, so nothing there is committed: PR bodies,
    check logs, notes. The coordinator sets COORDINATOR_SCRATCH, and a lane can't set COORDINATOR_*."""
    s = os.environ.get("COORDINATOR_SCRATCH", "") if os.environ.get("COORDINATOR_LANE") else ""
    if not os.path.isabs(s):
        return None
    try:
        return Path(s).resolve()
    except (OSError, RuntimeError):
        return None


def _resolved(p: Path) -> Path | None:
    try:
        return Path(os.path.normpath(p)).resolve()    # a symlink is judged by where it points
    except (OSError, RuntimeError):
        return None


def in_lane_scratch(p: Path) -> bool:
    s, r = lane_scratch(), _resolved(p)
    return s is not None and r is not None and r.is_relative_to(s)


def lane_task_output(p: Path, sid: str) -> bool:
    """Claude Code's own output file for this session's background command,
    <tmp>/claude-<uid>/<project>/<session>/tasks/<id>.output: the lane can't see the command's
    result any other way."""
    r = _resolved(p)
    if not sid or r is None:
        return False
    for base in {os.environ.get("CLAUDE_CODE_TMPDIR"), os.environ.get("TMPDIR"), "/tmp"} - {None, ""}:
        top = Path(base).resolve() / f"claude-{os.getuid()}"
        if r.is_relative_to(top):
            parts = r.relative_to(top).parts
            if len(parts) == 4 and parts[1] == sid and parts[2] == "tasks":
                return True
    return False


def lane_tool_result(p: Path, sid: str) -> bool:
    """Claude Code's spill file for this session's own large tool output,
    <config>/projects/<project>/<session>/tool-results/<file>: the lane sees the output only there."""
    r = _resolved(p)
    if not sid or r is None:
        return False
    top = _resolved(Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "projects")
    if top is None or not r.is_relative_to(top):
        return False
    parts = r.relative_to(top).parts
    return len(parts) == 4 and parts[1] == sid and parts[2] == "tool-results"


def lane_read_problem(tool: str, ti: dict, cwd: Path, sid: str = "") -> str | None:
    """A lane reads inside the worktree it runs in (its .claude/ skills included), its scratch
    directory, and its own background commands' output, judged on the resolved path: never /proc,
    credentials, the main checkout, or anything else on the machine."""
    here = repo_root(cwd)
    if here is None:
        return f"{cwd} is not inside the lane's repo"
    here = here.resolve()
    targets = [ti.get(k) for k in ("file_path", "notebook_path", "path") if ti.get(k)]
    for k in ("pattern", "glob"):   # Glob's pattern and Grep's glob are paths; Grep's pattern is a regex
        v = ti.get(k)
        if v and (tool == "Glob" or k == "glob"):
            fixed = re.split(r"[*?\[{]", v, maxsplit=1)[0]
            targets.append(fixed or ".")
    for t in targets or ["."]:
        if t.startswith("~") or "$" in t:
            return f"a lane reads files from its worktree only, not {t!r}"
        p = Path(t) if os.path.isabs(t) else cwd / t
        try:
            r = Path(os.path.normpath(p)).resolve()
        except (OSError, RuntimeError):
            return f"can't resolve {t!r}"
        if not r.is_relative_to(here) and not in_lane_scratch(r) and not lane_task_output(r, sid) \
                and not lane_tool_result(r, sid):
            return f"a lane reads files from its worktree only, not {t!r}"
    return None


def _vendored_copy_in_lane(args: list[str]) -> bool:
    """In a lane the coordinator runs these hooks from its run directory (`--settings`), copied from
    the main checkout. The worktree's vendored copy (`--project`, from .claude/settings.json) is the
    branch's own, which is older on a branch cut before a fix, and a deny from either one wins: a
    branch from before `git rebase origin/main` was allowed could never catch up. So it steps aside."""
    return "--project" in args and bool(os.environ.get("COORDINATOR_LANE"))


def hook_pre_tool_use(args: list[str]) -> int:
    if _vendored_copy_in_lane(args):
        return 0
    data = _hook_input()
    if os.environ.get("COORDINATOR_LANE") and not data:
        return _decision("deny", "coordinator lane: the hook's input couldn't be read; failing closed")
    ti = data.get("tool_input") or {}
    if data.get("tool_name") in LANE_READ_TOOLS:
        if not os.environ.get("COORDINATOR_LANE"):
            return 0   # a person's session reads anything
        cwd = Path(data.get("cwd") or os.getcwd())
        problem = _lane_machinery_problem(cwd) or lane_read_problem(data["tool_name"], ti, cwd,
                                                                    data.get("session_id", ""))
        return _decision("deny", f"coordinator lane: {problem}") if problem else 0
    target = ti.get("file_path") or ti.get("notebook_path")
    if not target:
        return 0
    cwd = Path(data.get("cwd") or os.getcwd())
    path = Path(target) if os.path.isabs(target) else cwd / target
    path = Path(os.path.normpath(path))
    if os.environ.get("COORDINATOR_LANE"):
        problem = _lane_machinery_problem(cwd)
        if not problem and in_lane_scratch(path):
            scratch, top = lane_scratch(), repo_root(path)
            below = _resolved(path).relative_to(scratch).parts
            if {".git", ".claude"} & set(below) or (top is not None and top.resolve().is_relative_to(scratch)):
                return _decision("deny", f"coordinator lane: {path} is in a repo inside the scratch directory: "
                                         f"scratch holds plain files")
            return 0    # the lane's own scratch: in no repo, owned by no role
        problem = problem or lane_edit_problem(path, cwd)
        if problem:
            return _decision("deny", f"coordinator lane: {problem}")
    root = repo_root(path)
    if root is None:
        return 0  # outside any repo: not ours to police
    roles = Roles(root)
    if not roles.roles:
        return 0  # repo doesn't use roles
    rel = path.relative_to(root).as_posix()

    if matches(rel, roles.repo.get("generated", [])):
        return _decision("deny", f"{rel} is generated. Regenerate it with the make target "
                                 "(e.g. `make backlog status`); never hand-edit it.")

    role = hook_role(root, data.get("session_id", ""))
    if role is None:
        return _decision("deny", f"No role set for this session. Ask the owner to run "
                                 f"/role <{roles.names()}> before editing {rel}.")
    if role == UNRESTRICTED:
        return 0
    if role in roles.owners(rel):
        return 0
    others = roles.owners(rel)
    if others:
        return _decision("deny", f"{rel} belongs to the {'/'.join(others)} role, not {role}. "
                                 "Stop and flag it, or route it to that role (a story comment "
                                 "--to <role>, or a plain issue).")
    return _decision("ask", f"{rel} isn't owned by any role. The {role} role needs the owner's "
                            "explicit approval to edit it.")


# ------------------------------------------------------------ bash gate parsing
#
# Quote-aware, not a shell. It errs toward finding a push: an over-match costs a
# rephrase, an under-match lets unreviewed code out. Known gaps are listed in
# the valesor-dev README.

def _close_paren(text: str, i: int) -> int:
    depth = 1
    while i < len(text):
        if text[i] == "(":
            depth += 1
        elif text[i] == ")":
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return len(text)


def _strip_heredocs(command: str) -> str:
    def keep_header(m: re.Match) -> str:
        line_start = command.rfind("\n", 0, m.start()) + 1
        before = command[line_start:m.start()]
        if before.count("$((") > before.count("))"):
            return m.group(0)  # a shift inside $(( )), not a heredoc
        header, _, rest = m.group(0).partition("\n")
        if m.group(1):
            return header + "\n"  # quoted delimiter: the body is literal text
        # Unquoted: the shell expands $(…) and `…` in the body, so keep the body
        # as a double-quoted argument to `:`, which _prescan already looks inside.
        lines = rest.split("\n")
        if lines and lines[-1].strip() == m.group(2):
            lines = lines[:-1]
        return f'{header}\n: "{_heredoc_as_dquoted(chr(10).join(lines))}"\n'
    return HEREDOC_RE.sub(keep_header, command)


def _heredoc_as_dquoted(body: str) -> str:
    """An unquoted heredoc body, re-escaped for a double-quoted string with the same
    expansions: backslash escapes only $, `, \\ and newline there; quotes are literal."""
    out, i = [], 0
    while i < len(body):
        c = body[i]
        if c == "\\" and i + 1 < len(body) and body[i + 1] in "$`\\\n":
            out.append(body[i:i + 2]); i += 2; continue
        out.append({"\\": "\\\\", '"': '\\"'}.get(c, c)); i += 1
    return "".join(out)


def _prescan(command: str) -> tuple[str, list[str]]:
    """Unquoted: drop `#` comments, turn backticks into newlines and `$(` into `(`.
    Also return the command substitutions found inside double quotes, which the
    shell runs too."""
    out: list[str] = []
    nested: list[str] = []
    quote, i, n = None, 0, len(command)
    while i < n:
        c = command[i]
        if c == "\\" and quote != "'" and i + 1 < n:
            out.append(command[i:i + 2]); i += 2; continue
        if quote == "'":
            quote = None if c == "'" else quote
            out.append(c); i += 1; continue
        subst = command.startswith("$(", i) and not command.startswith("$((", i)
        if quote == '"':
            if c == '"':
                quote = None
            elif subst or c == "`":
                j = _close_paren(command, i + 2) if subst else command.find("`", i + 1)
                j = n if j < 0 else j
                nested.append(command[i + (2 if subst else 1):j])
                out.append(command[i:j + 1]); i = j + 1; continue
            out.append(c); i += 1; continue
        if c in "'\"":
            quote = c; out.append(c)
        elif c == "`":
            out.append("\n")
        elif subst:
            out.append(" ( "); i += 2; continue
        elif c == "#" and (i == 0 or command[i - 1] in " \t\n;&|()"):
            j = command.find("\n", i)
            i = n if j < 0 else j
            continue
        else:
            out.append(c)
        i += 1
    return "".join(out), nested


def _tokens(text: str) -> list[str]:
    lex = shlex.shlex(text, posix=True, punctuation_chars=PUNCT)
    lex.whitespace = " \t\r"
    lex.whitespace_split = True
    lex.commenters = ""  # _prescan already dropped comments, keeping their newline
    try:
        return list(lex)
    except ValueError:  # unbalanced quotes: fall back to a plain split
        return [t for t in re.split(r"[ \t\r]+|([;&|()\n<>]+)", text) if t]


OPEN, CLOSE = ["\0("], ["\0)"]  # subshell boundaries, kept as sentinel segments


def _segments(tokens: list[str]) -> list[list[str]]:
    """Simple commands, with redirections (and their targets) removed."""
    segs: list[list[str]] = []
    cur: list[str] = []
    skip = False
    for t in tokens:
        if skip:
            skip = False
            continue
        if t and all(ch in PUNCT for ch in t):
            if "<" in t or ">" in t:
                if cur and cur[-1].isdigit():
                    cur.pop()  # the fd in `2>`
                skip = True  # the redirection target
                continue
            if cur:
                segs.append(cur)
            cur = []
            segs.extend(OPEN if ch == "(" else CLOSE for ch in t if ch in "()")
        else:
            cur.append(t)
    if cur:
        segs.append(cur)
    return segs


def _split_opts(args: list[str], with_value: set[str]) -> tuple[list[tuple[str, str]], list[str]]:
    """Options (name, value) and positionals; `--opt=v` and `--` handled."""
    opts, pos, i = [], [], 0
    while i < len(args):
        a = args[i]
        if a == "--":
            pos.extend(args[i + 1:]); break
        if a.startswith("-") and a != "-":
            if not a.startswith("--") and len(a) > 2 and a[:2] in with_value:
                name, val = a[:2], a[2:].removeprefix("=")  # attached: -Hbranch, -l=x
            else:
                name, eq, val = a.partition("=")
                if not eq and name in with_value and i + 1 < len(args):
                    val = args[i + 1]; i += 1
            opts.append((name, val))
        else:
            pos.append(a)
        i += 1
    return opts, pos


class Gated:
    def __init__(self, kind: str, where: Path, args: list[str], issue: str | None = None,
                 repo: str | None = None, via: list[str] | None = None):
        self.kind, self.where, self.args = kind, where, args
        self.issue, self.repo = issue, repo
        self.via = via or []   # env assignments and wrapper words the command was reached through


def _path(base: Path, p: str) -> Path:
    d = Path(os.path.expanduser(p))
    return d if d.is_absolute() else base / d


def _git_dir_worktree(p: Path) -> Path:
    return p.parent if p.name == ".git" else p


def _git_alias(where: Path, inline: dict[str, str], sub: str) -> str | None:
    if sub in inline:
        return inline[sub]
    root = repo_root(where) if where.exists() else None
    if root is None:
        return None
    r = subprocess.run(["git", "-C", str(root), "config", "--get", f"alias.{sub}"],
                       capture_output=True, text=True)
    return r.stdout.strip() or None


def _gated_git(rest: list[str], where: Path, depth: int) -> list[Gated]:
    inline: dict[str, str] = {}
    i = 0
    while i < len(rest) and rest[i].startswith("-"):
        name, eq, val = rest[i].partition("=")
        if not eq and name in GIT_OPTS_WITH_VALUE and i + 1 < len(rest):
            val = rest[i + 1]; i += 1
        if name == "-C":
            where = _path(where, val)
        elif name == "--git-dir":
            where = _git_dir_worktree(_path(where, val))
        elif name == "-c" and val.startswith("alias.") and "=" in val:
            k, _, v = val[len("alias."):].partition("=")
            inline[k] = v
        i += 1
    if i >= len(rest):
        return []
    sub, args = rest[i], rest[i + 1:]
    if sub == "push":
        return [Gated("git push", where, args)]
    if sub in GUARDED_GIT:
        return [Gated(f"git {sub}", where, args)]
    if sub in GIT_BUILTINS or depth >= 3:
        return []
    alias = _git_alias(where, inline, sub)
    if not alias:
        return []
    if alias.startswith("!"):
        return gated_commands(alias[1:] + " " + " ".join(shlex.quote(a) for a in args),
                              where, depth + 1)
    try:
        words = shlex.split(alias)
    except ValueError:
        words = alias.split()
    return _gated_git(words + args, where, depth + 1)


def gated_commands(command: str, cwd: Path, depth: int = 0) -> list[Gated]:
    """Every `git push` and `gh pr create` in a shell command, with the dir it runs in."""
    found: list[Gated] = []
    text, nested = _prescan(_strip_heredocs(command))
    if depth < 3:
        for sub in nested:
            found += gated_commands(sub, cwd, depth + 1)
    scopes: list[Path] = []  # cwd at each open subshell
    dirstack: list[Path] = []
    oldpwd = cwd
    for seg in _segments(_tokens(text)):
        if seg is OPEN:
            scopes.append(cwd)
            continue
        if seg is CLOSE:
            cwd = scopes.pop() if scopes else cwd
            continue
        where = cwd
        via: list[str] = []
        while seg:
            m = VAR_RE.match(seg[0])
            if m:
                if m.group(1) == "GIT_DIR":
                    where = _git_dir_worktree(_path(cwd, m.group(2)))
                via.append(seg[0]); seg = seg[1:]
            elif seg[0] in PREFIX_WORDS:
                seg = seg[1:]
            elif os.path.basename(seg[0]) in WRAPPERS:
                # skip to the command it runs: the first git/gh/shell/eval word
                via.append(seg[0])
                nxt = next((k for k, t in enumerate(seg[1:], 1)
                            if os.path.basename(t) in {"git", "gh", "pkill", "eval", *SHELLS, "python", "python3"}
                            or "/.claude/bin/" in t or t.startswith(".claude/bin/")), None)
                seg = seg[nxt:] if nxt else []
            else:
                break
        if not seg:
            if via:
                found.append(Gated("prefix", where, [], via=via))   # a bare assignment: a lane judges the name
            continue
        head, rest = os.path.basename(seg[0]), seg[1:]
        if "/.claude/bin/" in seg[0] or seg[0].startswith(".claude/bin/"):
            found.append(Gated("repo tool", where, [head, *rest], via=via))      # only a coordinator lane cares
        if head in ("python", "python3") and rest and ".claude/bin/" in rest[0]:
            found.append(Gated("repo tool", where, [os.path.basename(rest[0]), *rest[1:]], via=via))
        if head in ("cd", "pushd"):
            dirs = [t for t in rest if t == "-" or not t.startswith("-")]
            target = oldpwd if dirs[:1] == ["-"] else _path(cwd, dirs[0]) if dirs else None
            if target is not None:
                if head == "pushd":
                    dirstack.append(cwd)
                oldpwd, cwd = cwd, target
        elif head == "popd":
            if dirstack:
                oldpwd, cwd = cwd, dirstack.pop()
        elif head in SHELLS and depth < 3:
            flag = next((k for k, t in enumerate(rest) if SHELL_C_RE.match(t)), None)
            if flag is not None:
                body = next((t for t in rest[flag + 1:] if not t.startswith("-")), None)
                if body:
                    found += gated_commands(body, where, depth + 1)
        elif head in ("eval", "watch") and depth < 3:
            found += gated_commands(" ".join(t for t in rest if not t.startswith("-")),
                                    where, depth + 1)
        elif head == "git":
            found += _gated_git(rest, where, depth)
            found.append(Gated("git any", where, rest, via=via))
        elif head == "pkill":
            found.append(Gated("pkill", where, rest, via=via))
        elif head == "gh":
            found.append(Gated("gh any", where, rest, via=via))
            opts, pos = _split_opts(rest, GH_OPTS_WITH_VALUE)
            repo = next((v for n, v in opts if n in ("-R", "--repo")), None)
            if len(pos) >= 2 and pos[0] == "pr" and pos[1] in ("create", "new"):
                found.append(Gated("gh pr create", where, rest, via=via))
            elif len(pos) >= 2 and pos[0] == "issue":
                iopts, ipos = _split_opts(rest[rest.index("issue") + 1:], GH_ISSUE_OPTS_WITH_VALUE)
                repo = next((v for n, v in iopts if n in ("-R", "--repo")), repo)
                if ipos[:1] == ["edit"] and any(n in ("--add-project", "--remove-project")
                                                for n, _ in iopts):
                    found.append(Gated("gh issue edit --project", where, rest, via=via))
                elif ipos[:1] and ipos[0] in GH_ISSUE_WRITES:
                    refs = ipos[1:2] if ipos[0] == "transfer" else ipos[1:]  # transfer <issue> <repo>
                    found.append(Gated(f"gh issue {ipos[0]}", where, rest,
                                       issue=refs or None, repo=repo))
                elif ipos[:1] == ["create"] and any(n in ("-p", "--project") for n, _ in iopts):
                    found.append(Gated("gh issue create --project", where, rest, via=via))
            elif len(pos) >= 2 and pos[0] == "project" and pos[1] not in GH_PROJECT_READS:
                found.append(Gated(f"gh project {pos[1]}", where, rest, via=via))
            elif pos[:1] == ["api"]:
                api_args = rest[rest.index("api") + 1:]
                g = _gh_api_mutation(api_args, where)
                if g:
                    found.append(g)
                if _api_method_endpoint(api_args)[0] not in (None, "GET"):
                    found.append(Gated("gh api write", where, api_args, via=via))  # only a coordinator lane cares
    return found


def _api_method_endpoint(args: list[str]) -> tuple[str | None, str]:
    """(HTTP method, endpoint) of a `gh api` call; `-f`/`-F`/`--input` make it a POST."""
    opts, pos = _split_opts(args, GH_API_OPTS_WITH_VALUE)
    if not pos:
        return None, ""
    method = next((v for n, v in opts if n in ("-X", "--method")), None)
    if method is None:
        has_body = any(n in ("-f", "--raw-field", "-F", "--field", "--input") for n, _ in opts)
        method = "POST" if has_body else "GET"
    return method.upper(), pos[0].lstrip("/").split("?", 1)[0]


def _gh_api_mutation(args: list[str], where: Path) -> Gated | None:
    """A `gh api` call that changes a story's issue structure or a Project."""
    opts, pos = _split_opts(args, GH_API_OPTS_WITH_VALUE)
    if not pos:
        return None
    method = next((v for n, v in opts if n in ("-X", "--method")), None)
    if method is None:
        has_body = any(n in ("-f", "--raw-field", "-F", "--field", "--input") for n, _ in opts)
        method = "POST" if has_body else "GET"
    if method.upper() == "GET":
        return None
    endpoint = pos[0].lstrip("/").split("?", 1)[0]
    if endpoint == "graphql":
        fields = [v for n, v in opts if n in ("-f", "--raw-field", "-F", "--field")]
        if any("mutation" in v for v in fields) or any(n == "--input" for n, _ in opts) \
                or any(v.startswith("query=@") for v in fields):
            return Gated("gh api graphql mutation", where, args)
        return None
    if "projectsV2" in endpoint:
        return Gated("gh api projects", where, args)
    if re.search(r"(?:^|/)issues/\d+/(?:sub_issues?|dependencies)(?:/|$)", endpoint):
        return Gated("gh api issue links", where, args)
    m = ISSUE_API_RE.search(endpoint)
    if m:
        repo = "/".join(endpoint.split("/")[1:3]) if endpoint.startswith("repos/") else None
        return Gated("gh api issue", where, args, issue=[m.group(1)], repo=repo)
    return None


def pr_labels(args: list[str]) -> set[str]:
    """Labels from `gh pr create` options; other options' values aren't read as flags."""
    opts, _ = _split_opts(args, GH_PR_CREATE_OPTS_WITH_VALUE)
    return {x.strip() for n, v in opts if n in ("-l", "--label") for x in v.split(",")} - {""}


def pr_head(args: list[str]) -> str | None:
    opts, _ = _split_opts(args, GH_PR_CREATE_OPTS_WITH_VALUE)
    heads = [v for n, v in opts if n in ("-H", "--head") and v]
    return heads[-1].split(":", 1)[-1] if heads else None


def _commit(root: Path, rev: str) -> str | None:
    try:
        return _git(root, "rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}")
    except subprocess.CalledProcessError:
        return None


def _cleared(root: Path, sha: str) -> bool:
    """Reviewed by /pre-pr, or already on origin/main (merged, so reviewed there)."""
    if is_reviewed(root, sha):
        return True
    return subprocess.run(["git", "-C", str(root), "merge-base", "--is-ancestor", sha, "refs/remotes/origin/main"],
                          capture_output=True).returncode == 0


def push_problem(root: Path, args: list[str]) -> str | None:
    """Why this push may not go out, or None."""
    opts, pos = _split_opts(args, PUSH_OPTS_WITH_VALUE)
    names = {n for n, _ in opts}
    if names & {"--delete", "-d"}:
        return None
    if names & {"--all", "--mirror", "--tags", "--branches"}:
        return "push branches and tags by name in a role session, not with --all/--mirror/--tags"
    refspecs: list[str] = []
    words = pos[1:]  # the first positional is the repository, even with --repo (git push.c)
    while words:
        w = words.pop(0)
        if w == "tag" and words:
            w = f"refs/tags/{words.pop(0)}"
        refspecs.append(w)
    for spec in refspecs or ["HEAD"]:  # no refspec: the current branch
        src = spec.lstrip("+").split(":", 1)[0]
        if not src and ":" in spec:
            continue  # `:branch` deletes
        if "$" in src or "`" in src:
            src = "HEAD"  # a shell expansion (e.g. "$(git branch --show-current)"): the current branch
        sha = _commit(root, src or "HEAD")
        if sha is None:
            return f"can't resolve {src!r} to a commit"
        if not _cleared(root, sha):
            return f"{src or 'HEAD'} ({sha[:12]}) hasn't passed /pre-pr"
    return None


def _label_problem(args: list[str], role: str) -> str | None:
    want = pr_label(role)
    labels = pr_labels(args)
    wrong = sorted(l for l in labels if l.startswith("role:") and l != want)
    if wrong:
        return f"This session's role is {role}; label the PR {want}, not {', '.join(wrong)}."
    if want not in labels:
        return (f"PRs from the {role} role carry the {want} label. Re-run with `--label {want}`. "
                f"If GitHub says the label doesn't exist, ask the owner to create it "
                f"(gh label create {want}).")
    return None


STORY_TOOL = (".claude/bin/story (start, status, set, body, comment) so the role's "
              "transition rules apply")


def _origin_repo(root: Path) -> str | None:
    try:
        url = _git(root, "remote", "get-url", "origin")
    except subprocess.CalledProcessError:
        return None
    m = re.search(r"([^/:]+)/([^/:]+?)(?:\.git)?/?$", url)
    return f"{m.group(1)}/{m.group(2)}" if m else None


def _title_is_story(roles: Roles, root: Path, repo: str | None, ref: str) -> bool | None:
    """Is issue `ref` (a number or URL) a story or epic? None when it can't be checked."""
    m = re.search(r"github\.com/([^/]+/[^/]+)/issues/(\d+)", ref)
    ref = ref.lstrip("#")
    repo, number = (m.group(1), m.group(2)) if m else (repo, ref if ref.isdigit() else None)
    if not number or not repo:
        return None
    try:
        r = subprocess.run(["gh", "api", f"repos/{repo}/issues/{number}", "--jq", ".title"],
                           capture_output=True, text=True, timeout=15, cwd=root)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    prefix = re.escape(roles.repo.get("story_prefix") or "")
    sprint = re.escape((roles.repo.get("sprint_name") or "SPRINT").upper())
    # stories, epics, and this repo's sprint issues (SPRINT-05 — …); not RFC-12 — … or BUG-123 — …
    return bool(re.match(rf"^(?:{prefix}-[A-Z]+-\d{{3}}|EPIC-\d{{2}}|{sprint}-\d{{2,}}) — ",
                         r.stdout.strip()))


def _story_issue(roles: Roles, root: Path, g: Gated) -> bool | None:
    """True if any targeted issue is a story or epic, None if one can't be checked."""
    repo = g.repo or roles.repo.get("github_repo") or _origin_repo(root)
    if not g.issue:
        return None
    unknown = False
    for ref in g.issue:
        hit = _title_is_story(roles, root, repo, ref)
        if hit:
            return True
        unknown = unknown or hit is None
    return None if unknown else False


def story_problem(roles: Roles, root: Path, g: Gated) -> str | None:
    if not roles.repo.get("project"):
        return None  # this repo keeps no Project board
    if g.kind in ("gh issue edit", "gh issue close", "gh issue reopen", "gh issue delete",
                  "gh issue transfer", "gh api issue"):
        story = _story_issue(roles, root, g)
        if story is False:
            return None
        what = "is a story" if story else "may be a story (couldn't check its title)"
        refs = ", ".join(g.issue or []) or "(none given)"
        return f"{g.kind}: issue {refs} {what}. Change stories with {STORY_TOOL}."
    if g.kind in ("gh issue create --project", "gh issue edit --project"):
        return (f"{g.kind} adds an issue to the Project board. Create stories with "
                f".claude/bin/story create; create other issues without --project.")
    return f"{g.kind} changes the Project board. Change stories with {STORY_TOOL}."


def _short(name: str, flag: str, value_flags: str = "") -> bool:
    """`flag` in a short-option group (`-am`), before any option that takes the rest as a value."""
    if not name.startswith("-") or name.startswith("--"):
        return False
    for ch in name[1:]:
        if ch == flag:
            return True
        if ch in value_flags:
            return False
    return False


def _expand_longs(args: list[str], longs: list[str]) -> list[str]:
    """Replace each unique abbreviation of a known long option with its full name."""
    out = []
    for i, a in enumerate(args):
        if a == "--":
            return out + args[i:]
        name, eq, val = a.partition("=")
        if name.startswith("--") and len(name) > 2 and name not in longs:
            hits = [l for l in longs if l.startswith(name)]
            if len(hits) == 1:
                a = hits[0] + eq + val
        out.append(a)
    return out


def _uncommitted(where: Path, paths: list[str] | None = None) -> list[str]:
    """Tracked files with staged or unstaged changes, limited to `paths` when given."""
    if paths is not None and not paths:
        return []
    cmd = ["git", "-C", str(where), "status", "--porcelain", "--untracked-files=no"]
    if paths is not None:
        cmd += ["--", *paths]
    r = subprocess.run(cmd, capture_output=True, text=True)
    return [line[3:] for line in r.stdout.splitlines()] if r.returncode == 0 else []


def _ref(where: Path, name: str) -> str | None:
    """`name` as a commit, or as `origin/<name>` the way checkout and switch guess it."""
    return next((r for r in (name, f"origin/{name}") if _commit(where, r)), None)


def _rev(where: Path, candidates: list[str]) -> str:
    """The commit a forced switch or hard reset moves to: the first candidate that resolves."""
    return next((r for r in (_ref(where, c) for c in candidates) if r), "HEAD")


def _untracked_overwritten(where: Path, rev: str) -> list[str]:
    """Untracked files at paths `rev` tracks, which a forced checkout or hard reset replaces."""
    root = repo_root(where) if where.exists() else None
    if root is None:
        return []
    tree = subprocess.run(["git", "-C", str(root), "ls-tree", "-r", "-z", "--name-only", rev],
                          capture_output=True, text=True)
    index = subprocess.run(["git", "-C", str(root), "ls-files", "-z"], capture_output=True, text=True)
    if tree.returncode or index.returncode:
        return []
    tracked = set(index.stdout.split("\0"))
    hit: set[str] = set()
    for p in filter(None, tree.stdout.split("\0")):
        if p in tracked:
            continue
        if os.path.lexists(root / p):  # a file, directory, or symlink (even a broken one)
            hit.add(p)
            continue
        for parent in PurePosixPath(p).parents:  # `rev` has e/x where e is an untracked file
            q = parent.as_posix()
            if q != "." and q not in tracked and os.path.lexists(root / q) \
                    and (os.path.islink(root / q) or not (root / q).is_dir()):
                hit.add(q)
                break
    return sorted(hit)


def _checkout_paths(where: Path, args: list[str]) -> tuple[list[str] | None, bool]:
    """The paths a `git checkout` overwrites (None for the whole tree), and whether it's forced."""
    if "--" in args:
        return args[args.index("--") + 1:], False
    opts, pos = _split_opts(args, CHECKOUT_OPTS_WITH_VALUE)
    names = [n for n, _ in opts]
    if "--force" in names or any(_short(n, "f", "bB") for n in names):
        return None, True  # force wins over a new branch: `checkout -f -b` still discards
    if "--pathspec-from-file" in names:
        return None, False
    if any(n in ("-b", "-B", "--orphan") or _short(n, "b") or _short(n, "B") for n in names):
        return [], False  # a new branch keeps the changes
    # `git checkout [<tree-ish>] <pathspec>…` without `--`: every word that isn't a ref is a
    # pathspec, whether or not it exists (a deleted file, a quoted glob)
    return [p for p in pos if _ref(where, p) is None], False


def guard_problem(g: Gated) -> str | None:
    """Why a guarded git or shell command is denied, or None if it's safe here."""
    opts_for = {"git add": ADD_OPTS_WITH_VALUE, "git commit": COMMIT_OPTS_WITH_VALUE,
                "git restore": RESTORE_OPTS_WITH_VALUE, "git reset": set(),
                "git switch": SWITCH_OPTS_WITH_VALUE}
    args = _expand_longs(g.args, GUARD_LONGS.get(g.kind, []))
    forced_to: str | None = None  # the commit a forced switch or hard reset moves to
    if g.kind == "pkill":
        opts, _ = _split_opts(args, PKILL_OPTS_WITH_VALUE)
        if any(n == "--full" or _short(n, "f", "gGPstuUF") for n, _ in opts):
            return ("pkill -f matches whole command lines, so it can kill editors and other "
                    "sessions' servers. Find the process with `pgrep -a <name>`, check it, then "
                    "`kill <pid>`, or ask the owner.")
        return None
    if g.kind == "git checkout":
        paths, forced = _checkout_paths(g.where, args)
        if forced:
            _, pos = _split_opts(args, CHECKOUT_OPTS_WITH_VALUE)
            forced_to = _rev(g.where, pos)
    else:
        opts, pos = _split_opts(args, opts_for.get(g.kind, set()))
        names = [n for n, _ in opts]
        if g.kind == "git add":
            if any(n in ("-A", "--all", "--no-ignore-removal") or _short(n, "A") for n in names) \
                    or any(p in ADD_EVERYTHING for p in pos):
                return ("git add -A / --all / . stages work that may not be yours. Stage "
                        "explicit paths (`git add <path> …`) and leave changes you didn't make "
                        "unstaged.")
            return None
        if g.kind == "git commit":
            if "--all" in names or any(_short(n, "a", "mFCctSu") for n in names):
                return ("git commit -a commits every modified file, including work that may "
                        "not be yours. Stage explicit paths with `git add <path> …`, then commit.")
            return None
        if g.kind == "git restore":
            staged = any(n == "--staged" or _short(n, "S", "s") for n in names)
            worktree = any(n == "--worktree" or _short(n, "W", "s") for n in names)
            if staged and not worktree:
                return None  # unstaging keeps the changes
            paths = None if "--pathspec-from-file" in names else pos
        elif g.kind == "git reset":
            if "--hard" not in names:
                return None
            paths, forced_to = None, _rev(g.where, pos[:1])
        elif g.kind == "git switch":
            if not any(n in ("--discard-changes", "--force") or _short(n, "f", "cC") for n in names):
                return None
            paths, forced_to = None, _rev(g.where, pos)
        else:
            return None
    lost = _uncommitted(g.where, paths)
    if forced_to:
        lost += [f"{p} (untracked)" for p in _untracked_overwritten(g.where, forced_to)]
    if not lost:
        return None
    shown = ", ".join(lost[:5]) + (f" (+{len(lost) - 5} more)" if len(lost) > 5 else "")
    return (f"{g.kind} would discard uncommitted changes in {shown}. They may not be yours. "
            f"Commit them, or `git stash`, or ask the owner to discard them themselves "
            f"(`! git …` in the prompt).")


LANE_ONLY = {"gh api write", "git any", "gh any", "repo tool"}   # looked at only inside a lane
LANE_MAX_COMMAND, LANE_MAX_SEGMENTS = 8000, 12
LANE_ENV_RE = re.compile(
    r"\b(?:CLAUDE_SESSION_ID|CLAUDE_PROJECT_DIR|CLAUDE_ENV_FILE|COORDINATOR_[A-Z_]+)\b\s*=|"
    r"\b(?:unset|export|declare|typeset|readonly)\b[^;&|\n]*\b(?:CLAUDE_|COORDINATOR_)|"
    r"\benv\b[^;&|\n]*\s-(?:u|-unset)\b")
LANE_DANGER_VAR = re.compile(r"^(?:GIT_|GH_|CLAUDE_|COORDINATOR_|LD_|XDG_|DYLD_|BASH_|ZDOTDIR|PATH|HOME|TMPDIR|"
                             r"PAGER|EDITOR|VISUAL|SHELL|IFS|PS4|ENV|PROMPT_COMMAND|CDPATH|PYTHON|PERL|NODE|RUBY)")
LANE_SHELL_BUILTINS = {"export", "declare", "typeset", "readonly", "unset", "source", ".", "eval", "alias",
                       "enable", "trap", "exec", "env", "local", "setenv", "hash"}
LANE_SUBST_OK = {"git", "gh", "mktemp", "date", "basename", "dirname", "pwd", "echo", "printf", "true"}
LANE_READERS = {"wc", "head", "tail", "cut", "tr", "sort", "uniq", "grep", "cat"}   # in-worktree files only
LANE_VAR_OK = {"CLAUDE_SESSION_ID", "CLAUDE_PROJECT_DIR", "PWD", "OLDPWD", "HOME", "TMPDIR", "USER"}
LANE_VAR_RE = re.compile(r"\$(?:\{[#!]?)?([A-Za-z_][A-Za-z0-9_]*)")
LANE_ROLE_VERBS = {"require", "show", "owners", "check-cmd", "reviewed", "list"}
LANE_TOOLS = {"role", "story", "sprint-state", "codex-review"}
LANE_GIT_GLOBAL_OK = {"--no-pager", "-P", "--no-optional-locks"}
LANE_GIT_SUBS = {"status", "diff", "log", "show", "fetch", "branch", "switch", "checkout", "add", "commit",
                 "push", "merge-base", "rev-parse", "rev-list", "ls-files", "worktree", "grep", "ls-tree",
                 "rebase", "merge"}
LANE_GIT_DENIED_LONG = ("--output", "--upload-pack", "--receive-pack", "--exec", "--exec-path", "--ext-diff",
                        "--textconv", "--open-files-in-pager", "--git-dir", "--work-tree", "--config-env", "--no-index")
SAFE_REF = re.compile(r"[A-Za-z0-9._/-]+")
LANE_GH_VALUE_OPTS = GH_ISSUE_OPTS_WITH_VALUE | GH_API_OPTS_WITH_VALUE | {
    "--json", "-q", "--jq", "--head", "-H", "--state", "-s", "--limit", "-L", "--base", "-B", "--search",
    "-S", "--author", "-A", "--app", "--hostname", "--cache", "--template", "-t", "--title"}
_PR_CREATE_OK = {"-t", "--title", "-b", "--body", "-F", "--body-file", "-l", "--label", "-B", "--base", "-H",
                 "--head", "-d", "--draft", "-f", "--fill", "--fill-first", "--fill-verbose", "-T", "--template",
                 "--no-maintainer-edit"}
_COMMENT_OK = {"-b", "--body", "-F", "--body-file"}
LANE_GH_WRITE_OPTS = {   # the only options a lane passes to gh's writes (no --dry-run push, no
    ("pr", "create"): _PR_CREATE_OK, ("pr", "new"): _PR_CREATE_OK,     # --delete-last, no --parent)
    ("pr", "comment"): _COMMENT_OK, ("issue", "comment"): _COMMENT_OK,
    ("issue", "create"): {"-t", "--title", "-b", "--body", "-F", "--body-file", "-l", "--label"},
    ("issue", "close"): {"-c", "--comment", "-r", "--reason"},
}
LANE_GH_VERBS = {"pr": {"create", "new", "view", "list", "diff", "checks", "comment", "status"},
                 "issue": {"list", "view", "comment", "close", "create"}}
# gh run, for CI evidence: list and view only (never rerun, cancel, delete, download, or watch), and only
# these options, per verb, because one letter means different things there (-w: --workflow on list,
# --web on view). (options that take a value, flags)
_GH_OUT = {"--json", "-q", "--jq", "-t", "--template"}
LANE_GH_RUN_OPTS = {
    "list": ({"-w", "--workflow", "-b", "--branch", "-e", "--event", "-c", "--commit", "-s", "--status",
              "-u", "--user", "--created", "-L", "--limit"} | _GH_OUT, {"-a", "--all"}),
    "view": ({"-j", "--job", "--attempt"} | _GH_OUT, {"--log", "--log-failed", "-v", "--verbose", "--exit-status"}),
}
LANE_API_READ = re.compile(r"(?:pulls|issues|commits|compare|branches)(?:/.*)?")
LANE_API_REPLY = re.compile(r"(?:pulls/\d+/comments/\d+/replies|issues/\d+/comments)")
LANE_WORKFLOW_DIRS = (".github/workflows/", ".github/actions/")


def _lane_file_problem(value: str, where: Path) -> str | None:
    """A file a lane hands to git, gh, or story must be inside its own worktree (or stdin): anything
    else is a local file (credentials, /proc/self/environ) that the command would publish."""
    if value == "-":
        return None
    if value.startswith(("~", "<", ">", "(")) or "$" in value or "`" in value:
        return f"a lane reads files from its worktree only, not {value!r}"
    root = repo_root(where)
    p = Path(os.path.normpath(value if os.path.isabs(value) else where / value))
    if in_lane_scratch(p):
        return None
    try:
        inside = root is not None and p.resolve().is_relative_to(root.resolve())
    except OSError:
        inside = False
    return None if inside else f"a lane reads files from its worktree only, not {value!r}"


def _option_files(args: list[str], long_names: set[str], short_names: set[str]) -> list[str]:
    """Values of file-taking options, in every spelling (`--f x`, `--f=x`, `-Fx`, `-F x`)."""
    out, i = [], 0
    while i < len(args):
        a = args[i]
        name, eq, val = a.partition("=")
        if name in long_names or name in short_names:
            out.append(val if eq else (args[i + 1] if i + 1 < len(args) else ""))
            i += 0 if eq else 1
        elif a.startswith("-") and not a.startswith("--") and len(a) > 2 and a[:2] in short_names:
            out.append(a[2:].removeprefix("="))
        i += 1
    return out


def _denied_long(name: str) -> bool:
    """A long option git would read as one of the dangerous ones, abbreviation included."""
    return name.startswith("--") and len(name) >= 4 and any(f.startswith(name) for f in LANE_GIT_DENIED_LONG)


def _split_git(args: list[str]) -> tuple[list[str], str | None, list[str]]:
    i, glob = 0, []
    while i < len(args) and args[i].startswith("-"):
        glob.append(args[i])
        if args[i] in GIT_OPTS_WITH_VALUE and i + 1 < len(args):
            glob.append(args[i + 1]); i += 1
        i += 1
    return glob, (args[i] if i < len(args) else None), args[i + 1:]


def _lane_branch_prefix(g: Gated, sid: str) -> tuple[Path | None, str | None, str | None]:
    root = repo_root(g.where)
    if root is None:
        return None, None, None
    roles = Roles(root)
    role = hook_role(root, sid)
    return root, role, (roles.roles[role][0].get("branch_prefix") if role in roles.roles else None)


def lane_push_problem(g: Gated, sid: str, args: list[str]) -> str | None:
    """A lane pushes `origin` only, flags from a short whitelist, refspecs of plain branch names whose
    destination is under the role's `branch_prefix`, and never workflow changes."""
    root, role, prefix = _lane_branch_prefix(g, sid)
    if root is None:
        return "can't tell which repo this push is for"
    if not prefix:
        return f"role {role!r} has no branch_prefix, so a lane can't push"
    opts, pos = _split_opts(args, PUSH_OPTS_WITH_VALUE)
    for n, _ in opts:
        if n not in ("--set-upstream", "--quiet", "--verbose") and \
                not (re.fullmatch(r"-[uqv]+", n)):
            return f"a lane pushes with -u/-q/-v only, not {n}"
    if pos and pos[0] != "origin":
        return f"a lane pushes to origin only, not {pos[0]!r}"
    specs = pos[1:]
    if not specs:   # git follows push.default and the upstream: name the branch, or it can reach main
        return "name the branch: git push -u origin <branch> (a bare push follows push.default)"
    for spec in specs:
        if spec.startswith(("+", ":")) or not re.fullmatch(r"[A-Za-z0-9._/-]+(?::[A-Za-z0-9._/-]+)?", spec):
            return f"a lane pushes plain branch names, not {spec!r}"
        src, _, dst = spec.partition(":")
        dst = (dst or src).removeprefix("refs/heads/")
        cur = ""
        try:
            cur = _git(g.where, "branch", "--show-current").strip()
        except (subprocess.CalledProcessError, OSError):
            pass
        dst = cur if dst == "HEAD" else dst
        if dst in ("main", "master", "HEAD") or not prefix.endswith("/"):
            return f"a lane never pushes {dst or '?'} (its role's branch_prefix must end in `/`: {prefix!r})"
        if ".." in dst or not dst.startswith(prefix):
            return f"a {role} lane pushes only branches under {prefix} (this goes to {dst or '?'})"
        srcref = cur if src == "HEAD" else src.removeprefix("refs/heads/")
        sha = _commit(root, srcref)
        try:
            # -z: plain output quotes a name with non-ASCII or special characters ("…), which
            # would slip past the prefix check below
            changed = [n for n in _git(g.where, "diff", "-z", "--name-only", "--no-renames",
                                       f"refs/remotes/origin/main...{sha}").split("\0") if n] if sha else None
        except (subprocess.CalledProcessError, OSError):
            changed = None
        if changed is None:
            return f"can't compare {srcref!r} with origin/main to check what it changes"
        if any(p.startswith(LANE_WORKFLOW_DIRS) for p in changed):
            return ("this push changes a GitHub workflow (.github/workflows or actions), which runs "
                    "with the repo's secrets: a person pushes those")
    return None


def _is_head_commit(where: Path, ref: str) -> bool:
    """`git checkout -b x origin/main` in a worktree still at origin/main is a branch at HEAD."""
    if not SAFE_REF.fullmatch(ref) or ref.startswith("-"):
        return False
    rev = lambda r: subprocess.run(["git", "-C", str(where), "rev-parse", "--verify", "--quiet",  # noqa: E731
                                    f"{r}^{{commit}}"], capture_output=True, text=True).stdout.strip()
    head = rev("HEAD")
    return bool(head) and rev(ref) == head


def _lane_new_branch_problem(g: Gated, sid: str, name: str) -> str | None:
    root, role, prefix = _lane_branch_prefix(g, sid)
    if root is None or not prefix:
        return f"role {role!r} has no branch_prefix, so a lane can't create a branch"
    if not SAFE_REF.fullmatch(name) or name.startswith(("origin/", "refs/", "-")) or name in ("HEAD", "main"):
        return f"a lane's branch is a plain name under {prefix!r}, not {name!r}"
    if not prefix.endswith("/") or not name.startswith(prefix):
        return f"a lane's branches start with {prefix!r}, not {name!r}"
    return None


def lane_catch_up_problem(g: Gated, sub: str, args: list[str]) -> str | None:
    """A lane brings its branch up to date with origin/main and nothing else: `git rebase origin/main`
    while the branch is unpushed (a rebased pushed branch needs a force push, which a lane never does),
    `git merge origin/main` once it is pushed, and the --continue/--abort that finish either."""
    args = [a for a in args if a not in ("-q", "--quiet")]
    if sub == "merge":
        args = [a for a in args if a != "--no-edit"]
    ctl = ("--continue", "--abort", "--skip") if sub == "rebase" else ("--continue", "--abort")
    if len(args) == 1 and args[0] in ctl:
        return None
    if args not in (["origin/main"], ["refs/remotes/origin/main"]):
        return (f"a lane runs `git {sub} origin/main` (or `git {sub} {'|'.join(ctl)}`), "
                f"with no other options or refs")
    if sub == "merge":
        return None
    try:
        cur = _git(g.where, "branch", "--show-current").strip()
    except (subprocess.CalledProcessError, OSError):
        return "can't tell which branch this rebase is on"
    if cur and subprocess.run(["git", "-C", str(g.where), "rev-parse", "--verify", "--quiet",
                               f"refs/remotes/origin/{cur}"], capture_output=True).returncode == 0:
        return (f"{cur} is already on origin: rebasing it would need a force push. "
                f"Use `git merge origin/main` instead")
    return None


def lane_git_problem(g: Gated, sid: str) -> str | None:
    glob, sub, args = _split_git(g.args)
    bad = [x for x in glob if x not in LANE_GIT_GLOBAL_OK]
    if bad:
        return f"a lane runs git without {bad[0]} (config, paths, and exec options are set by the repo)"
    if sub not in LANE_GIT_SUBS:
        return f"git {sub} isn't something a lane runs"
    for a in args:
        if a == "--":
            break
        if _denied_long(a.split("=", 1)[0]):
            return f"a lane never passes {a.split('=', 1)[0]} to git (it writes files or runs commands)"
    opts, pos = _split_opts(args, {"-m", "-F", "-C", "-c", "-b", "-B", "--format", "--pretty", "-n", "-U", "-S"})
    names = [n for n, _ in opts]
    if sub in ("diff", "log", "show", "ls-files"):
        # git diff reads two paths outside the repo as --no-index, and its output is publishable
        for a in pos:
            if a.startswith(("/", "~")) or "$" in a or ".." in a.split("/"):
                why = _lane_file_problem(a, g.where)
                if why:
                    return why
    if sub in ("commit", "add"):
        for f in _option_files(args, {"--file", "--template", "--pathspec-from-file"}, {"-F", "-t"}):
            why = _lane_file_problem(f, g.where)
            if why:
                return why
    if sub == "push":
        return lane_push_problem(g, sid, args)
    if sub == "fetch":
        if any(n not in ("-q", "--quiet", "-v", "--verbose") for n in names):
            return "a lane fetches with -q/-v only"
        if pos and pos[0] != "origin":
            return f"a lane fetches origin only, not {pos[0]!r}"
        if pos[1:] not in ([], ["main"]):   # a refspec can bring in a fork's or a PR's commits
            return "a lane fetches `origin` or `origin main`, no other refspec"
    elif sub in ("checkout", "switch"):
        # A new branch at HEAD, or (switch only) one of the role's own branches whose tree still
        # carries .claude/: moving the checkout to a commit without it drops the hooks.
        args = [a for a in args if a not in ("-q", "--quiet")]
        if len(args) in (2, 3) and args[0] in ("-b", "-c", "--create"):
            if len(args) == 3 and not _is_head_commit(g.where, args[2]):
                return (f"a lane creates its branch at HEAD; {args[2]!r} isn't HEAD's commit "
                        f"(its worktree already starts at origin/main)")
            return _lane_new_branch_problem(g, sid, args[1])
        if sub == "switch" and len(args) == 1 and not args[0].startswith("-"):
            why = _lane_new_branch_problem(g, sid, args[0])
            if why:
                return why
            for p in (".claude/bin/role", ".claude/roles"):
                if subprocess.run(["git", "-C", str(g.where), "cat-file", "-e", f"refs/heads/{args[0]}:{p}"],
                                  capture_output=True).returncode != 0:
                    return f"a lane switches only to a branch that carries {p} (so the hooks stay), not {args[0]!r}"
            return None
        return ("a lane creates a branch at HEAD with `git switch -c <name>` or `git checkout -b <name>`, or "
                "switches to one of its own branches; it never moves its checkout elsewhere")
    elif sub in ("rebase", "merge"):
        return lane_catch_up_problem(g, sub, args)
    elif sub == "grep":
        # -O/--open-files-in-pager runs a command; -f reads patterns from a file
        head = args[:args.index("--")] if "--" in args else args
        if any(re.fullmatch(r"-[A-Za-z0-9]*O.*", a) for a in head):
            return "a lane never passes -O to git grep (it runs a command)"
        for f in _option_files(args, {"--file"}, {"-f"}):
            why = _lane_file_problem(f, g.where)
            if why:
                return why
    elif sub == "branch":
        if not args or any(a not in ("--show-current", "--list", "-a", "-r", "-v", "-vv") for a in args):
            return "a lane reads branches (--show-current, --list); it doesn't delete or move them"
    elif sub == "worktree":
        verb = pos[0] if pos else None
        if verb not in ("add", "list", "remove", "prune"):
            return "a lane uses git worktree add, list, remove, or prune"
        if any(n in ("-f", "--force", "--lock") or re.fullmatch(r"-[a-z]*f[a-z]*", n) for n in names):
            return "a lane never forces a worktree add or remove"
        if verb in ("remove", "add"):
            try:
                lanes = (_common_dir(g.where).parent / ".claude" / "worktrees").resolve()
                for target in pos[1:]:
                    if "$" in target or "`" in target:
                        continue    # `$(mktemp -d)/review`: /pre-pr's reviewer; the path isn't the lanes' dir
                    t = Path(os.path.normpath(target if os.path.isabs(target) else g.where / target)).resolve()
                    if in_lane_scratch(t):
                        return f"a lane never {verb}s a worktree in its scratch directory: scratch holds plain files"
                    if t == lanes or t.is_relative_to(lanes):
                        return f"a lane never {verb}s a worktree under the lanes' directory (.claude/worktrees)"
            except (subprocess.CalledProcessError, OSError):
                return "can't tell which worktree that is"
    return None


def lane_tool_problem(args: list[str], where: Path) -> str | None:
    tool, rest = args[0], args[1:]
    if tool not in LANE_TOOLS:
        return f".claude/bin/{tool} isn't a lane's tool"
    if tool == "role":
        verb = next((a for a in rest if not a.startswith("-")), None)
        if verb not in LANE_ROLE_VERBS:
            return "a lane can't change roles or sessions (role set/clear)"
    if tool == "story":
        if any(re.fullmatch(r"--s(?:i(?:d)?)?(?:=.*)?", a) for a in rest):   # argparse accepts abbreviations
            return "a lane acts as its own session; story --sid is for people"
        for f in _option_files(rest, {"--body-file", "--file"}, set()):
            why = _lane_file_problem(f, where)
            if why:
                return why
    return None


def _without_repo(args: list[str], with_value: set[str]) -> list[str]:
    """`args` without its -R/--repo options, parsed as `_split_opts` parses them (an option's value
    that happens to read `-R` stays)."""
    out, i = [], 0
    while i < len(args):
        a = args[i]
        if a == "--":
            return out + args[i:]
        name = a[:2] if a.startswith("-R") and not a.startswith("--") else a.partition("=")[0]
        if name in ("-R", "--repo"):
            i += 1 if (a != name) else 2
            continue
        out.append(a)
        if a.startswith("-") and "=" not in a and a in with_value and i + 1 < len(args):
            out.append(args[i + 1]); i += 1
        i += 1
    return out


def lane_gh_problem(g: Gated, sid: str) -> str | None:
    root = repo_root(g.where)
    repo = (Roles(root).repo.get("github_repo") if root else None) or ""
    opts, pos = _split_opts(g.args, LANE_GH_VALUE_OPTS)
    for n, v in opts:
        if n == "--hostname" or (n in ("-R", "--repo") or re.fullmatch(r"-R.+", n)) and (not repo or v != repo):
            return f"a lane talks to this repo only (no --hostname, and --repo/-R only as {repo or '?'})"
    args = _without_repo(g.args, LANE_GH_VALUE_OPTS)   # --repo <this repo> is the default anyway
    opts, pos = _split_opts(args, LANE_GH_VALUE_OPTS)
    if not pos:
        return "gh needs a verb"
    head, verb = pos[0], (pos[1] if len(pos) > 1 else None)
    if head == "run":
        if verb not in LANE_GH_RUN_OPTS:
            return f"gh run {verb} isn't a lane's (CI runs: list and view only)"
        values, flags = LANE_GH_RUN_OPTS[verb]
        ropts, rpos = _split_opts(args, values)
        bad = [n for n, _ in ropts if n not in values | flags]
        if bad:
            return f"gh run {verb} in a lane takes {', '.join(sorted(o for o in values | flags if o.startswith('--')))} only, not {bad[0]}"
        if rpos[:2] != ["run", verb] or any(not re.fullmatch(r"\d+", x) for x in rpos[2:]):
            return "a lane names runs by number (no URLs, other repos, or branch names)"
        return None
    if head in LANE_GH_VERBS:
        if verb not in LANE_GH_VERBS[head]:
            return f"gh {head} {verb} isn't a lane's (it never merges, closes a PR, or approves)"
        if any(not re.fullmatch(r"\d+", x) for x in pos[2:]):
            return "a lane names pull requests and issues by number (no URLs, owner/repo#N, or branch names)"
        if any(n in ("-S", "--search") for n, _ in opts):
            return "a lane doesn't search (a search qualifier can reach other repos)"
        allowed = LANE_GH_WRITE_OPTS.get((head, verb))
        if allowed is not None:
            bad = [n for n, _ in opts if n not in allowed]
            if bad:
                return (f"gh {head} {verb} in a lane takes {', '.join(sorted(o for o in allowed if o.startswith('--')))} "
                        f"only, not {bad[0]}")
        if head == "pr" and verb in ("create", "new"):
            for n, v in opts:
                if n in ("-H", "--head") and ":" in v:
                    return "a lane opens a pull request from its own branch (no <owner>:<branch> head)"
        for f in _option_files(args, {"--body-file", "--template", "--recover"}, {"-F", "-T"}):
            why = _lane_file_problem(f, g.where)
            if why:
                return why
        return None
    if head != "api":
        return f"gh {head} isn't a lane's"
    api = args[args.index("api") + 1:]
    aopts, apos = _split_opts(api, GH_API_OPTS_WITH_VALUE)
    if sum(1 for n, _ in aopts if n in ("-X", "--method")) > 1:
        return "gh api with more than one method"
    method, endpoint = _api_method_endpoint(api)
    if re.search(r"\.\.|%|//|#|\\", endpoint):
        return "a lane's gh api endpoint has no `..`, encoding, `//`, or `#` in it"
    for v in _option_files(api, {"--field"}, {"-F"}):
        if "=@" in v:
            why = _lane_file_problem(v.split("=@", 1)[1], g.where)
            if why:
                return why
    for f in _option_files(api, {"--input"}, set()):
        why = _lane_file_problem(f, g.where)
        if why:
            return why
    m = re.fullmatch(r"repos/([^/]+/[^/]+)/(.+)", endpoint)
    if not m or (m.group(1) != repo and m.group(1) != "{owner}/{repo}"):
        return "a lane's gh api calls stay inside this repo (repos/<this repo>/...)"
    tail = m.group(2)
    if method == "GET":
        return None if LANE_API_READ.fullmatch(tail) else "a lane reads pulls, issues, commits, compare, and branches through the API"
    if method == "POST" and LANE_API_REPLY.fullmatch(tail):
        return None
    return ("a lane may only read the API and reply to PR comments (POST repos/<this repo>/pulls/N/"
            "comments/ID/replies or issues/N/comments); it never merges, closes, approves, or deletes")


def _substitutions(text: str) -> list[str]:
    """Bodies of every `$(...)`, backtick, `<(...)` and `>(...)` outside single quotes, nested ones
    included (the shell runs them all, quoted or not)."""
    out: list[str] = []
    quote, i, n = None, 0, len(text)
    while i < n:
        c = text[i]
        if c == "\\" and quote != "'" and i + 1 < n:
            i += 2; continue
        if quote == "'":
            quote = None if c == "'" else quote
            i += 1; continue
        if c == "'" and quote is None:
            quote = c; i += 1; continue
        if c == '"':
            quote = None if quote == '"' else '"'
            i += 1; continue
        if (text.startswith("$(", i) and not text.startswith("$((", i)) or (quote is None and text.startswith(("<(", ">("), i)):
            j = _close_paren(text, i + 2)
            j = n if j < 0 else j
            body = text[i + 2:j]
            out.append(body); out += _substitutions(body)
            i = j + 1; continue
        if c == "`":
            j = text.find("`", i + 1)
            j = n if j < 0 else j
            body = text[i + 1:j]
            out.append(body); out += _substitutions(body)
            i = j + 1; continue
        i += 1
    return out


def _simple_commands(text: str) -> list[list[str]]:
    """Every simple command in `text`, leading shell keywords dropped (assignment prefixes kept)."""
    out: list[list[str]] = []
    for seg in _segments(_tokens(_prescan(_strip_heredocs(text))[0])):
        if seg is OPEN or seg is CLOSE or not seg:
            continue
        out.append([t for t in seg if t not in PREFIX_WORDS] or seg)
    return out


def _lane_var_problem(command: str) -> str | None:
    """A `$NAME` the lane's environment has (GH_TOKEN, ANTHROPIC_API_KEY, ...) would put its value
    in a comment, a commit or a PR. Single-quoted text isn't expanded; `$WT` the lane set itself is
    fine, and so are a few names that are paths or ids, not secrets."""
    quote, out = None, []
    for i, c in enumerate(command):
        if c == "'" and quote != '"' and (i == 0 or command[i - 1] != "\\"):
            quote = None if quote == "'" else "'"
            continue
        if c == '"' and quote != "'":
            quote = None if quote == '"' else '"'
        out.append(" " if quote == "'" else c)
    for m in LANE_VAR_RE.finditer("".join(out)):
        if m.group(1) in os.environ and m.group(1) not in LANE_VAR_OK:
            return f"a lane doesn't expand ${m.group(1)} (it is in the lane's environment and may be a credential)"
    return None


# Flags that make the repo's build tools run something other than the repo's own targets: a lane's
# `make check`/`go test` runs the Makefile and code on its branch, not a file or program it names.
# (A Makefile variable can still change a command; the lane's OS user is the boundary for that.)
LANE_EXEC_FLAGS = {"make": {"--eval", "-E", "-f", "--file", "--makefile", "-C", "--directory", "-I",
                            "--include-dir"},
                   "go": {"-exec", "--exec", "-toolexec", "--toolexec", "-overlay", "--overlay"}}


# terraform in a lane: these subcommands with these options only. No backend (no state, no
# credentials), no plan or apply, no module or plugin from elsewhere; `-chdir` stays in the worktree.
# (`init` still downloads the providers the config names, and `validate` runs them: the owner's call.)
LANE_TERRAFORM = {"version": {"-json"},
                  "fmt": {"-check", "-diff", "-recursive", "-list=false", "-write=false", "-no-color"},
                  "validate": {"-json", "-no-color"},
                  "init": {"-backend=false", "-input=false", "-no-color", "-lockfile=readonly", "-upgrade"}}


def _lane_terraform_problem(seg: list[str], where: Path) -> str | None:
    if os.path.basename(seg[0]) != "terraform":
        return None
    args = seg[1:]
    while args and args[0].startswith("-chdir="):
        if _lane_file_problem(args[0].split("=", 1)[1], where):
            return "a lane's terraform -chdir names a directory in its worktree"
        args = args[1:]
    verb = args[0] if args else ""
    if verb not in LANE_TERRAFORM:
        return f"terraform {verb or '(no subcommand)'} isn't a lane's (version, fmt, validate, init -backend=false)"
    for a in args[1:]:
        if a.startswith("-"):
            if a not in LANE_TERRAFORM[verb]:
                return f"terraform {verb} in a lane takes {', '.join(sorted(LANE_TERRAFORM[verb]))} only, not {a}"
        elif verb != "fmt" or _lane_file_problem(a, where):
            return f"terraform {verb} in a lane names no path but a directory in its worktree (fmt only)"
    if verb == "init" and "-backend=false" not in args:
        return "a lane runs terraform init only with -backend=false (no state backend, no credentials)"
    return None


def _lane_exec_flag_problem(seg: list[str]) -> str | None:
    tool = seg[0]
    if tool not in LANE_EXEC_FLAGS:
        return None
    for a in seg[1:]:
        if a == "--":
            break
        name = a.split("=", 1)[0]
        short = tool == "make" and re.fullmatch(r"-[A-Za-z]+.*", a) and not a.startswith("--") \
            and any(c in "fCIE" for c in re.match(r"-([A-Za-z]+)", a).group(1))
        if name in LANE_EXEC_FLAGS[tool] or short or (tool == "make" and name in ("SHELL", ".SHELLFLAGS",
                                                                                     "MAKEFLAGS", "MAKEFILES")):
            return f"a lane runs {tool} without {name} (it would run something other than the repo's own targets)"
    return None


# Readers a lane runs as commands (the coordinator allows them), and inside $(...): every file they
# name is judged. Long options are matched exactly, from these tables: GNU tools take any unique
# prefix (`diff --from=F` is `--from-file=F`) and some take an optional value (`--unified[=N]`), so
# an option the tables don't know is refused rather than guessed at. Values: short options whose
# value follows (`-n 5`, `-n5`), long ones (`--x v`, `--x=v`), and the ones whose value is a file.
LANE_FILE_READERS = {"grep", "head", "tail", "wc", "ls", "diff", "cat", "cut", "tr", "sort", "uniq"}
_GREP_FLAGS = {"--recursive", "--dereference-recursive", "--line-number", "--count", "--ignore-case",
               "--no-ignore-case", "--invert-match", "--word-regexp", "--line-regexp", "--files-with-matches",
               "--files-without-match", "--only-matching", "--quiet", "--silent", "--no-messages",
               "--with-filename", "--no-filename", "--extended-regexp", "--fixed-strings", "--basic-regexp",
               "--perl-regexp", "--text", "--null", "--null-data", "--byte-offset", "--initial-tab",
               "--line-buffered", "--color", "--colour"}
READER_OPTS = {   # cmd: (short with value, long flags, long with value, short file, long file)
    "grep": ({"-e", "-m", "-A", "-B", "-C", "-d", "-D"}, _GREP_FLAGS,
             {"--regexp", "--max-count", "--context", "--after-context", "--before-context", "--include",
              "--exclude", "--exclude-dir", "--label", "--directories", "--devices", "--binary-files",
              "--color", "--colour"}, {"-f"}, {"--file", "--exclude-from"}),
    "head": ({"-n", "-c"}, {"--quiet", "--silent", "--verbose", "--zero-terminated"}, {"--lines", "--bytes"},
             set(), set()),
    "tail": ({"-n", "-c"}, {"--quiet", "--silent", "--verbose", "--zero-terminated"}, {"--lines", "--bytes"},
             set(), set()),   # no -f/--follow: it never ends
    "wc": (set(), {"--lines", "--words", "--chars", "--bytes", "--max-line-length"}, {"--total"}, set(), set()),
    "ls": ({"-w", "-I", "-T"}, {"--all", "--almost-all", "--recursive", "--human-readable", "--classify",
                                "--directory", "--size", "--reverse", "--numeric-uid-gid", "--inode",
                                "--color", "--group-directories-first"},
           {"--sort", "--time", "--format", "--width", "--ignore", "--hide", "--color", "--time-style"},
           set(), set()),
    "diff": ({"-U", "-C", "-L", "-I", "-x"}, {"--unified", "--context", "--recursive", "--brief", "--new-file",
                                              "--ignore-case", "--ignore-all-space", "--ignore-space-change",
                                              "--ignore-blank-lines", "--side-by-side", "--text", "--normal",
                                              "--report-identical-files", "--minimal", "--strip-trailing-cr",
                                              "--no-dereference", "--color", "--suppress-common-lines"},
             {"--label", "--exclude", "--ignore-matching-lines", "--width"}, {"-X"}, {"--exclude-from"}),
    "cat": (set(), {"--number", "--number-nonblank", "--show-all", "--show-ends", "--show-tabs",
                    "--squeeze-blank"}, set(), set(), set()),
    "cut": ({"-d", "-f", "-b", "-c"}, {"--complement", "--only-delimited"},
            {"--delimiter", "--fields", "--bytes", "--characters", "--output-delimiter"}, set(), set()),
    "tr": (set(), {"--delete", "--squeeze-repeats", "--complement", "--truncate-set1"}, set(), set(), set()),
    "sort": ({"-k", "-t"}, {"--reverse", "--numeric-sort", "--unique", "--ignore-case", "--version-sort",
                            "--human-numeric-sort", "--stable"}, {"--key", "--field-separator"}, set(), set()),
    "uniq": ({"-f", "-s", "-w"}, {"--count", "--repeated", "--unique", "--ignore-case"},
             {"--skip-fields", "--skip-chars", "--check-chars"}, set(), set()),
}
READER_NO_SHORT = {"tail": "fF", "sort": "oT", "ls": ""}   # -f follows forever; sort -o writes, -T is a dir
OPTIONAL_VALUE = {"--unified", "--context", "--color", "--colour"}   # `=value` only


def _reader_files(cmd: str, args: list[str]) -> tuple[list[str], str | None]:
    """The files a reader names (its operands, grep's first being the pattern unless -e or -f gave
    one, and file-taking options' values), or why its options can't be read."""
    svals, lflags, lvals, sfiles, lfiles = READER_OPTS[cmd]
    files, pos, given, i, ended = [], [], False, 0, False
    while i < len(args):
        a = args[i]
        if ended or a == "-" or not a.startswith("-"):
            pos.append(a)
        elif a == "--":
            ended = True
        elif a.startswith("--"):
            name, eq, v = a.partition("=")
            if name in OPTIONAL_VALUE and (name in lflags or name in lvals):
                pass        # `--unified`, `--unified=3`, `--color=never`: never takes the next word
            elif name in lflags and not eq:
                pass
            elif name in lvals or name in lfiles:
                if not eq:
                    i += 1
                    v = args[i] if i < len(args) else ""
                if name in lfiles:
                    files.append(v)
                given = given or name in ("--regexp", "--file")
            else:
                return [], f"a lane spells {cmd}'s options in full, from the ones it knows, not {name!r}"
        else:
            for j, ch in enumerate(a[1:], 1):
                o = "-" + ch
                if ch in READER_NO_SHORT.get(cmd, ""):
                    return [], f"a lane doesn't run {cmd} {o}"
                if o in svals or o in sfiles:
                    v = a[j + 1:]
                    if not v:
                        i += 1
                        v = args[i] if i < len(args) else ""
                    if o in sfiles:
                        files.append(v)
                    given = given or o in ("-e", "-f")
                    break
        i += 1
    if cmd == "grep" and not given:
        pos = pos[1:]
    if cmd == "tr":
        pos = []    # tr reads stdin only: its operands are sets
    if cmd == "uniq" and len(pos) > 1:
        return [], "a lane runs uniq on one input at most: its second operand is a file it writes"
    return files + [p for p in pos if p != "-"], None


def _lane_cd_problem(seg: list[str], where: Path) -> str | None:
    """Files in a command are judged from the session's directory, so a `cd` inside it would move
    them out from under the check. A lane changes directory only to its worktree's top."""
    if os.path.basename(seg[0]) not in ("cd", "pushd", "popd"):
        return None
    root = repo_root(where)
    args = [a for a in seg[1:] if a != "--"]
    if seg[0] == "cd" and len(args) == 1 and root is not None and "$" not in args[0] and "~" not in args[0]:
        t = _resolved(Path(args[0] if os.path.isabs(args[0]) else where / args[0]))
        if t is not None and t == root.resolve():
            return None
    return "a lane changes directory only to its worktree's top (`cd <worktree>`); name paths from there"


def _lane_reader_problem(seg: list[str], where: Path) -> str | None:
    cmd = os.path.basename(seg[0])
    if cmd not in LANE_FILE_READERS:
        return None
    files, why = _reader_files(cmd, seg[1:])
    if why:
        return why
    for f in files:
        if not f or _lane_file_problem(f, where):
            return f"a lane reads files from its worktree or its scratch directory only, not {f!r}"
    return None


def lane_shell_problem(command: str, where: Path, sid: str = "") -> str | None:
    """Shell syntax a lane may not use: builtins that change the environment or run text, a
    command substitution running anything but a reader, and redirections outside the worktree."""
    why = _lane_var_problem(command)
    if why:
        return why
    for seg in _simple_commands(command):
        if os.path.basename(seg[0]) in LANE_SHELL_BUILTINS:
            return f"a lane doesn't run the shell builtin {seg[0]!r}"
        why = _lane_exec_flag_problem(seg) or _lane_terraform_problem(seg, where)
        if why:
            return why
        why = _lane_reader_problem(seg, where) or _lane_cd_problem(seg, where)
        if why:
            return why
    for body in _substitutions(command):
        for seg in _simple_commands(body):
            h = os.path.basename(seg[0])
            if VAR_RE.match(seg[0]):
                return f"a lane sets no variables inside a command substitution ({seg[0].split('=', 1)[0]})"
            if h in LANE_READERS:
                why = _lane_reader_problem(seg, where)
                if why:
                    return why
            elif h not in LANE_SUBST_OK and ".claude/bin/" not in seg[0]:
                return f"a lane runs {seg[0]!r} as a command, not inside $(...) or backticks where it isn't judged"
    return _lane_redirect_problem(command, where, sid)


def _lane_owned_write_problem(root: Path, rel: str, sid: str) -> str | None:
    """What Edit/Write would refuse this lane at `rel`, for a shell redirect that writes the same file.
    A path no role owns is refused too: Edit asks the owner there, and a lane has no one to ask."""
    roles = Roles(root)
    if matches(rel, roles.repo.get("generated", [])):
        return f"{rel} is generated: its make target writes it, never a lane"
    role = hook_role(root, sid)
    if role == UNRESTRICTED or (role and role in roles.owners(rel)):
        return None
    others = roles.owners(rel)
    if others:
        return f"{rel} belongs to the {'/'.join(others)} role, not {role}: a redirect is no way around that"
    return f"{rel} isn't owned by any role, so a lane doesn't write it (Edit would ask the owner)"


def _lane_redirect_problem(command: str, where: Path, sid: str = "") -> str | None:
    texts = [command, *_substitutions(command)]
    for text in texts:
        toks = _tokens(_prescan(_strip_heredocs(text))[0])
        for k, t in enumerate(toks):
            if not t or not all(ch in PUNCT for ch in t) or not ("<" in t or ">" in t):
                continue
            if "(" in t:
                return "a lane doesn't use process substitution (`<(...)`, `>(...)`)"
            op = t.lstrip("&") if t.startswith("&") else t
            nxt = toks[k + 1] if k + 1 < len(toks) else ""
            if "<<<" in op or op.startswith("<<"):      # here-string or here-doc marker: not a file
                continue
            if op.endswith("&") and (nxt.isdigit() or nxt == "-"):   # fd duplication: 2>&1, >&2
                continue
            target = nxt.rstrip("&") if nxt else ""
            if not target:
                return "a lane's redirection names its file"
            if target.startswith(("(", "\0")):
                return "a lane doesn't use process substitution (`<(...)`, `>(...)`)"
            if target in ("/dev/null", "/dev/stdout", "/dev/stderr"):
                continue
            why = _lane_file_problem(target, where)
            if why:
                return f"a lane redirects to and from files in its worktree or its scratch directory only, not {target!r}"
            if in_lane_scratch(Path(target if os.path.isabs(target) else where / target)):
                continue
            root = repo_root(where)
            rel = Path(os.path.normpath(target if os.path.isabs(target) else where / target)).resolve()
            parts = rel.relative_to(root.resolve()).parts if root else ()
            if parts and parts[0] in (".git", ".claude"):
                return f"a lane never redirects into {parts[0]}/ ({target!r}): that is the repo's own machinery"
            if ">" in op and parts:   # a write: the role's `writes`, as for Edit and Write
                why = _lane_owned_write_problem(root, "/".join(parts), sid)
                if why:
                    return why
    return None


def lane_problem(g: Gated, sid: str) -> str | None:
    """What a coordinator lane (COORDINATOR_LANE set) may not do, judged on the tokenized command, not
    a prefix match. The allow-list the coordinator passes is a second layer: this is the one that
    knows which flags, remotes, endpoints, and refs are fine."""
    if g.kind == "prefix":   # `NAME=value` on its own: fine unless it changes a variable commands read
        for a in g.via:
            name = a.split("=", 1)[0]
            if name in os.environ or LANE_DANGER_VAR.match(name) or not VAR_RE.match(a):
                return f"a lane doesn't set {name} (it is in the lane's environment, or a shell wrapper)"
        return None
    if g.via:
        return (f"a lane runs git, gh, and the repo's tools directly, not through {g.via[0]!r} "
                f"(an env prefix or a wrapper changes what they do)")
    if g.kind == "repo tool":
        return lane_tool_problem(g.args, g.where)
    if g.kind == "git any":
        return lane_git_problem(g, sid)
    if g.kind == "gh any":
        return lane_gh_problem(g, sid)
    return None


def _common_dir(r: Path) -> Path:
    d = Path(_git(r, "rev-parse", "--git-common-dir"))
    return (d if d.is_absolute() else r / d).resolve()


def _lane_machinery_problem(cwd: Path) -> str | None:
    """A lane whose checkout no longer carries the role files (a checkout moved to a commit without
    .claude/) has lost the hooks' ground truth: nothing it does can be judged."""
    root = repo_root(cwd)
    if root is None:
        return f"{cwd} is not inside the lane's repo"
    if not (root / ".claude" / "roles").is_dir() or not Roles(root).roles \
            or not (root / ".claude" / "bin" / "role").is_file():
        return "this checkout has no .claude/roles or .claude/bin/role: a lane can't work from a tree without them"
    return None


def lane_edit_problem(path: Path, cwd: Path) -> str | None:
    """A lane edits files inside its own repo's worktrees: not outside any repo, not another repo,
    and not the main checkout where a person works."""
    try:
        path = path.resolve()    # a symlink is judged by where it points
    except (OSError, RuntimeError):
        return f"can't resolve {path}"
    here, there = repo_root(cwd), repo_root(path)
    if there is None or here is None:
        return f"a lane edits files inside its repo's worktrees, not {path}"
    try:
        common = _common_dir(here)
        same = common == _common_dir(there)
    except (subprocess.CalledProcessError, OSError):
        return "can't tell which repo that path belongs to"
    main_root = common.parent
    lanes = main_root / ".claude" / "worktrees"
    if same and there.resolve().is_relative_to(lanes) and there.resolve() != here.resolve():
        return f"{path} is another lane's worktree: a lane edits its own"
    if not same or there.resolve() != here.resolve():
        return (f"{path} is outside this lane's worktree: a lane edits the worktree it runs in, "
                f"never a throwaway one, another repo, or the main checkout")
    parts = path.relative_to(there.resolve()).parts
    if parts and parts[0] in (".claude", ".git"):
        return f"{path} is the repo's own machinery ({parts[0]}/): a lane never edits it"
    return None


def hook_pre_bash(args: list[str]) -> int:
    if _vendored_copy_in_lane(args):
        return 0
    data = _hook_input()
    command = (data.get("tool_input") or {}).get("command") or ""
    cwd = Path(data.get("cwd") or os.getcwd())
    asks: list[str] = []
    lane = os.environ.get("COORDINATOR_LANE")
    if lane and len(command) > LANE_MAX_COMMAND:   # parsing cost grows with it; a hook that times out allows
        return _decision("deny", f"coordinator lane {lane}: command too long ({len(command)} > "
                                 f"{LANE_MAX_COMMAND} characters); split it")
    found = gated_commands(command, cwd)
    if lane and sum(1 for g in found if g.kind in ("git any", "gh any", "repo tool")) > LANE_MAX_SEGMENTS:
        return _decision("deny", f"coordinator lane {lane}: too many git/gh/tool commands in one call "
                                 f"(more than {LANE_MAX_SEGMENTS}); split it")
    if lane:  # set by the coordinator for the sessions it starts, never by a lane itself
        if not data:
            return _decision("deny", f"coordinator lane {lane}: the hook's input couldn't be read; failing closed")
        if LANE_ENV_RE.search(command):
            return _decision("deny", f"coordinator lane {lane}: a lane doesn't set or unset the session "
                                     f"variables (CLAUDE_*, COORDINATOR_*)")
        problem = lane_shell_problem(command, cwd, data.get("session_id", "")) or _lane_machinery_problem(cwd)
        if problem:
            return _decision("deny", f"coordinator lane {lane}: {problem}")
        for g in found:
            problem = lane_problem(g, data.get("session_id", ""))
            if problem:
                return _decision("deny", f"coordinator lane {lane}: {problem}")
    found = [g for g in found if g.kind not in LANE_ONLY and g.kind != "prefix"]
    for g in found:  # guards apply in every mode, with or without a role or a role repo
        if g.kind == "pkill" or g.kind.removeprefix("git ") in GUARDED_GIT:
            problem = guard_problem(g)
            if problem:
                return _decision("deny", problem)
    for g in found:
        if g.kind == "pkill" or g.kind.removeprefix("git ") in GUARDED_GIT:
            continue
        root = repo_root(g.where)
        if root is None:
            continue
        roles = Roles(root)
        if not roles.roles:
            continue
        role = hook_role(root, data.get("session_id", ""))
        if g.kind not in ("gh pr create", "git push"):
            problem = story_problem(roles, root, g)
            if problem is None:
                continue
            if role is None:
                return _decision("deny", f"No role set for this session. {problem}")
            if role != UNRESTRICTED:
                return _decision("deny", problem)
            asks.append(problem)
            continue
        if role is None:
            return _decision("deny", f"No role set for this session. Ask the owner to run "
                                     f"/role <{roles.names()}> before running {g.kind}.")
        if g.kind == "gh pr create":
            if role != UNRESTRICTED:
                label = _label_problem(g.args, role)
                if label:
                    return _decision("deny", label)
            ref = pr_head(g.args)
            if ref is None:
                ref, sha = "HEAD", head_sha(root)
            else:
                # Never fall back to HEAD: an unresolved --head names other commits.
                sha = _commit(root, ref) or _commit(root, f"refs/remotes/origin/{ref}")
            if ref != "HEAD" and sha is None:
                problem = (f"--head {ref} doesn't resolve locally (no branch {ref} or "
                           f"origin/{ref}), so its commits can't be checked; fetch it first")
            else:
                problem = None if sha and _cleared(root, sha) else \
                    f"{ref} {sha[:12] if sha else '(no commits)'} hasn't passed /pre-pr"
        else:
            problem = push_problem(root, g.args)
        if problem is None:
            continue
        reason = (f"{g.kind}: {problem}. Run /pre-pr (checks plus the adversarial review) "
                  f"first; any new commit needs a fresh review.")
        if role != UNRESTRICTED:
            return _decision("deny", reason)
        asks.append(reason)
    if asks:
        return _decision("ask", " ".join(asks))
    return 0


COMMANDS = {
    "list": cmd_list,
    "help": cmd_help,
    "set": cmd_set,
    "show": cmd_show,
    "require": cmd_require,
    "clear": cmd_clear,
    "check-cmd": cmd_check_cmd,
    "owners": cmd_owners,
    "reviewed": cmd_reviewed,
    "hook-session-start": hook_session_start,
    "hook-pre-tool-use": hook_pre_tool_use,
    "hook-pre-bash": hook_pre_bash,
}


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in COMMANDS:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        return COMMANDS[argv[0]](argv[1:])
    except Exception as e:  # noqa: BLE001
        if argv[0] in ("hook-pre-bash", "hook-pre-tool-use"):
            # a hook that crashes exits non-zero, which the harness treats as "no decision": allow
            return _decision("deny", f"the role hook failed ({type(e).__name__}: {e}); failing closed")
        raise


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
